/* =====================================================================
   SUSPECTED VEHICLE ANOMALY  +  EFFECTIVE SUPPLY
   -------------------------------------------------------------------
   AI 只負責「發現與預測」，不宣稱已確認故障。
   effectiveAvail = max(0, reportedAvail - suspectedFault)
   資料結構刻意與未來真實 API 對齊：
     avail          — API 帳面可借車（保留原欄位）
     reportedAvail  — 帳面可借（= avail，未來可由 API 提供）
     suspectedFault — 疑似異常車數（由偵測模型產生）
     longestIdleMin — 最長未出現合理狀態變化的分鐘數
   ===================================================================== */

// 有效可用車輛（供給估計）
function effectiveAvail(s){
  const reported = (s.reportedAvail ?? s.avail ?? 0);
  const fault    = (s.suspectedFault ?? 0);
  return Math.max(0, reported - fault);
}
// alias per spec
function calculateEffectiveAvail(station){ return effectiveAvail(station); }

// 安全庫存：至少 3 台，或站點容量的 20%
function safeReserve(s){ return Math.max(3, Math.ceil((s.cap||0)*0.2)); }
// 可調度數（扣除安全庫存後的有效供給）
function dispatchable(s){ return Math.max(0, effectiveAvail(s) - safeReserve(s)); }

// 疑似異常偵測：回傳 {level, reason, faults, idleMin}
// 只產生「疑似」警示，不宣稱已確認故障。
function detectVehicleAnomaly(s){
  const faults = s.suspectedFault ?? 0;
  const idle   = s.longestIdleMin ?? 0;
  if(faults<=0){
    return {level:'normal', faults:0, idleMin:idle, reason:''};
  }
  let level='normal';
  if(idle>120) level='critical';
  else if(idle>=60) level='warning';
  else level='warning'; // 有疑似車但停留時間短，仍給予 warning 提示
  return {
    level, faults, idleMin:idle,
    reason: `疑似 ${faults} 台車長時間停留（最長 ${fmtIdle(idle)}）`
  };
}
// 以「有效供給可能高估的百分比」量化資料異常
function supplyOverestimatePct(s){
  const reported = (s.reportedAvail ?? s.avail ?? 0);
  if(reported<=0) return 0;
  return Math.round(((s.suspectedFault ?? 0)/reported)*100);
}
function fmtIdle(min){
  min=Math.round(min||0);
  if(min<60) return `${min}m`;
  const h=Math.floor(min/60), m=min%60;
  return `${h}h ${String(m).padStart(2,'0')}m`;
}

/* =====================================================================
   SERVICE LAYER  (Phase 2)
   -------------------------------------------------------------------
   All predictive logic is isolated behind small service objects so the
   mock implementation can later be swapped for a real backend WITHOUT
   touching UI code. The public method signatures are the integration
   contract:

     predictionService.getStationRisk30(station) -> 0..100   [MOCK / 模擬預測]
     predictionService.getStationRisk60(station) -> 0..100   [MOCK / 模擬預測]
       ↑ replace body with fetch() to FastAPI -> SageMaker XGBoost endpoint.

     demandService.getDemandProfile(station)     -> {delta30,delta60,trend,estimated30,estimated60}
     priorityService.calculateDispatchPriority(station) -> {score, reason, ...}
     dispatchService.getSourceCandidates(target) -> [{station, dist, eta, dispatchable, riskAfter}]
     simulationService.simulateDispatch(target, source, bikes) -> {...post-dispatch projection}
     simulationService.calculateDispatchBenefit(sim, plan) -> {score, feasible, verdict, reasons}
   ===================================================================== */

// ---- shared risk model (rule-based; NOT the model itself) -------------
// Risk rises as EFFECTIVE supply approaches 0 relative to a comfortable buffer.
// projectedSupply lets us reuse the same curve for now / +30 / +60 min.
function riskFromSupply(projectedEff, cap){
  const comfort = Math.max(6, Math.round(cap*0.25));   // supply we'd like to keep
  const ratio = Math.min(1, Math.max(0,projectedEff)/comfort);
  // gentler convex falloff: empty projection ~= 88%, comfortable ~= 8%
  let risk = 88*Math.pow(1-ratio, 1.15) + 8;
  return Math.max(4, Math.min(95, Math.round(risk)));
}

/* ===== predictionService ===== [MOCK / DEMO — rule-based, NOT a real model]
   -------------------------------------------------------------------
   source==='mock' means these numbers are DEMO estimates, not XGBoost.
   Unified prediction contract (getPrediction) so the whole Decision Engine
   consumes ONE shape. To go live, replace getPrediction() with a fetch()
   to FastAPI -> SageMaker XGBoost that returns the SAME object; nothing
   downstream needs to change.

   getPrediction(station) -> {
     risk30, risk60,                          // 0..1  缺車風險
     predictedAvailableRatio30/60,            // 0..1  預測可借車 / 容量
     predictedEmptyDockRatio30/60,            // 0..1  預測可還位 / 容量
     confidence,                              // 0..1  預測信心 (DEMO)
     source                                   // 'mock' | 'xgboost'
   } */
const predictionService = {
  source: 'mock',   // 'mock' -> DEMO/模擬預測 ; 'xgboost' -> XGBoost Prediction
  label(){ return this.source==='xgboost' ? 'XGBoost Prediction' : 'DEMO / MOCK 模擬預測'; },
  isMock(){ return this.source!=='xgboost'; },

  // project EFFECTIVE available bikes forward using recent supply change (demand trend)
  _projectEff(s, minutes){
    const eff = effectiveAvail(s);
    const per30 = (s.delta30 ?? 0);
    if(minutes<=30) return Math.max(0, Math.round(eff + per30*(minutes/30)));
    return Math.max(0, Math.round(eff + per30 + (s.delta30 ?? 0)*0.7*((minutes-30)/30)));
  },
  // project EMPTY docks forward using recent empty-dock change
  _projectEmpty(s, minutes){
    const emp = (s.empty ?? 0);
    const per30 = (s.deltaEmpty30 ?? 0);
    if(minutes<=30) return Math.max(0, Math.round(emp + per30*(minutes/30)));
    return Math.max(0, Math.round(emp + per30 + (s.deltaEmpty30 ?? 0)*0.7*((minutes-30)/30)));
  },
  // unified prediction (all stations, always returns a fallback shape)
  getPrediction(s){
    const cap = Math.max(1, s.cap||1);
    const eff30 = this._projectEff(s,30), eff60 = this._projectEff(s,60);
    const emp30 = this._projectEmpty(s,30), emp60 = this._projectEmpty(s,60);
    // confidence (DEMO): higher when trend is consistent & station is larger
    const trendConsistent = Math.sign(s.delta30??0)===Math.sign(s.delta60??0);
    const conf = Math.max(0.55, Math.min(0.9, 0.62 + (trendConsistent?0.14:0) + Math.min(cap,40)/40*0.14));
    return {
      source: this.source,
      risk30: riskFromSupply(eff30, cap)/100,
      risk60: riskFromSupply(eff60, cap)/100,
      predictedAvailableRatio30: Math.min(1, eff30/cap),
      predictedAvailableRatio60: Math.min(1, eff60/cap),
      predictedEmptyDockRatio30: Math.min(1, emp30/cap),
      predictedEmptyDockRatio60: Math.min(1, emp60/cap),
      confidence: Math.round(conf*100)/100
    };
  },
  // risk of an arbitrary projected supply value (used by simulation)
  riskOf(projEff, cap){ return riskFromSupply(projEff, cap); },
  // legacy adapters (0..100) — kept so existing callers keep working
  getStationRisk30(s){ return Math.round(this.getPrediction(s).risk30*100); },
  getStationRisk60(s){ return Math.round(this.getPrediction(s).risk60*100); }
};
// convenience wrappers per spec
function getStationRisk30(s){ return predictionService.getStationRisk30(s); }
function getStationRisk60(s){ return predictionService.getStationRisk60(s); }
// attach/refresh station.prediction (fallback for EVERY station)
function computeStationPrediction(s){ s.prediction = predictionService.getPrediction(s); return s.prediction; }
function getPrediction(s){ return s.prediction || computeStationPrediction(s); }

/* ===== demandService ===== 供需趨勢 (time-windowed supply change) */
const demandService = {
  getDemandProfile(s){
    const delta30 = (s.delta30 ?? 0);
    const delta60 = (s.delta60 ?? 0);
    let trend='STABLE';
    if(delta30 <= -3 || delta60 <= -6) trend='FAST_FALLING';
    else if(delta30 < 0 || delta60 < 0) trend='FALLING';
    else if(delta30 > 1 || delta60 > 2) trend='RISING';
    return {
      delta30, delta60, trend,
      estimated30: predictionService._projectEff(s,30),
      estimated60: predictionService._projectEff(s,60)
    };
  },
  trendLabel(trend){
    return trend==='FAST_FALLING' ? '車輛快速流失 · 需求快速上升'
         : trend==='FALLING'      ? '車輛供給下降 · 需求上升'
         : trend==='RISING'       ? '車輛供給回升'
         : '供需大致穩定';
  }
};
function stationDemandProfile(s){ return demandService.getDemandProfile(s); }

/* ===== priorityService ===== Decision Engine (rule-based, not "AI") */
const priorityService = {
  // 0..100 priority for allocating LIMITED dispatch resources.
  calculateDispatchPriority(s){
    const risk30 = getStationRisk30(s);
    const risk60 = getStationRisk60(s);
    const cap = s.cap||1;
    const prof = demandService.getDemandProfile(s);
    const dur = imbalanceDuration(s);              // 長時間失衡（分鐘）

    // weighted components (each ~0..1)
    const cRisk   = (risk30*0.6 + risk60*0.4)/100;                    // future risk
    const cCap    = Math.min(cap,50)/50;                             // bigger station serves more users
    const cUsers  = Math.min(expectedAffectedUsers(s),60)/60;         // expected affected users
    const cTrend  = prof.trend==='FAST_FALLING'?1 : prof.trend==='FALLING'?0.6 : 0.2;
    const cDur    = Math.min(dur,120)/120;                           // sustained imbalance
    const cImp    = Math.min(s.importance??1, 1.4)/1.4;              // station importance

    let score = 100*( cRisk*0.42 + cCap*0.14 + cUsers*0.16 + cTrend*0.12 + cDur*0.10 + cImp*0.06 );
    score = Math.max(0, Math.min(100, Math.round(score)));

    // human-readable reason (top contributing factors)
    const bits=[];
    if(cRisk>0.6) bits.push('未來30分鐘風險高');
    if(cCap>0.6) bits.push('大容量站點');
    else if(cCap<0.3) bits.push('站點規模較小');
    if(cUsers>0.5) bits.push('高需求');
    if(cTrend>=0.6) bits.push('持續失衡');
    if(cDur>0.5) bits.push('長時間失衡');
    if((s.importance??1)>1.1) bits.push('轉運要點');
    const reason = bits.length? bits.join(' + ') : '風險與需求適中';
    return { score, reason, risk30, risk60, trend:prof.trend, duration:dur };
  }
};
function calculateDispatchPriority(s){ return priorityService.calculateDispatchPriority(s); }

// 目前供需失衡已持續分鐘數（來自狀態回報，非「未處置時間」）
function imbalanceDuration(s){ return s.imbalanceDuration ?? 0; }
// 預估受影響使用者（規則估計）：容量 + 缺口 + 趨勢
function expectedAffectedUsers(s){
  const gap = Math.max(0, Math.round(s.cap*0.25) - effectiveAvail(s));
  const trendPush = Math.max(0, -(s.delta30 ?? 0)) * 1.5;
  return Math.round(gap*2 + trendPush + s.cap*0.15);
}

/* ===== dispatchService ===== source optimization */
const dispatchService = {
  gridDist(a,b){ return Math.abs(a.gx-b.gx)+Math.abs(a.gy-b.gy); },
  km(a,b){ return this.gridDist(a,b)*0.35+0.4; },
  baseEta(a,b){ return Math.round(this.km(a,b)*4+4); },
  eta(a,b){
    const base=this.baseEta(a,b);
    if(typeof ADDON!=='undefined'){
      try{ return base + ADDON.roadDelayMin(a,b); }catch(e){ return base; }
    }
    return base;
  },
  // candidate sources, scored by post-dispatch source risk (not distance-only)
  getSourceCandidates(target, bikes){
    const want = bikes || 10;
    return DATA.stations
      .filter(s=>s.id!==target.id && dispatchable(s)>0)
      .map(s=>{
        const take = Math.min(want, dispatchable(s));
        const projEffAfter = effectiveAvail(s) - take;
        // project source forward after losing `take` bikes, using its own trend
        const proj30 = Math.max(0, projEffAfter + (s.delta30 ?? 0));
        const riskAfter = predictionService.riskOf(proj30, s.cap);
        return {
          station:s,
          dist:this.km(s,target),
          eta:this.eta(s,target),
          dispatchable:dispatchable(s),
          take,
          riskAfter
        };
      })
      // rank: low post-dispatch source risk first, then more dispatchable, then closer
      .sort((a,b)=> a.riskAfter-b.riskAfter || b.dispatchable-a.dispatchable || a.dist-b.dist);
  }
};
function getSourceCandidates(target, bikes){ return dispatchService.getSourceCandidates(target, bikes); }

/* ===== simulationService ===== post-dispatch scenario + benefit */
const simulationService = {
  // Project a station's effective supply after +addBikes, then 30/60 min forward.
  _project(s, addBikes){
    const now = Math.max(0, effectiveAvail(s) + addBikes);
    const p30 = Math.max(0, now + (s.delta30 ?? 0));
    const p60 = Math.max(0, now + (s.delta60 ?? 0));
    return {now, p30, p60};
  },
  // minutes until projected effective supply drops back to a "high risk" threshold
  _stableMinutes(s, addBikes){
    const now = effectiveAvail(s)+addBikes;
    const perMin = (s.delta30 ?? 0)/30;           // supply change per minute (usually negative)
    const threshold = Math.max(2, Math.round(s.cap*0.12));
    if(perMin>=0) return 120;                     // not falling -> stable (cap at 2h for display)
    const mins = (now-threshold)/(-perMin);
    return Math.max(0, Math.min(120, Math.round(mins)));
  },
  simulateDispatch(target, source, bikes){
    const t = this._project(target, +bikes);
    const sProj = this._project(source, -bikes);
    return {
      bikes,
      targetAfterDispatch: t.now,
      sourceAfterDispatch: sProj.now,
      target30: t.p30, target60: t.p60,
      source30: sProj.p30, source60: sProj.p60,
      targetRisk30: predictionService.riskOf(t.p30, target.cap),
      targetRisk60: predictionService.riskOf(t.p60, target.cap),
      sourceRisk30: predictionService.riskOf(sProj.p30, source.cap),
      sourceRisk60: predictionService.riskOf(sProj.p60, source.cap),
      targetRiskAfter: predictionService.riskOf(t.now, target.cap),
      estimatedStableMinutes: this._stableMinutes(target, +bikes)
    };
  },
  // Benefit = target risk reduction + stability - source risk increase - dispatch cost
  calculateDispatchBenefit(target, source, bikes){
    const feasibleBikes = bikes<=dispatchable(source);
    const sim = this.simulateDispatch(target, source, bikes);
    const riskBefore = getStationRisk30(target);
    const riskReduction = Math.max(0, riskBefore - sim.targetRisk30);   // 0..~90
    const stability = sim.estimatedStableMinutes;                       // 0..120
    const sourceRiskBefore = getStationRisk30(source);
    const sourceRiskIncrease = Math.max(0, sim.sourceRisk30 - sourceRiskBefore);
    const cost = bikes;                                                 // more bikes = more cost/effort

    let score = riskReduction*1.0 + stability*0.35 - sourceRiskIncrease*1.1 - cost*0.8;
    score = Math.round(score);

    const sourceBecomesHigh = sim.sourceRisk30 >= 65;
    const feasible = feasibleBikes && !sourceBecomesHigh;

    const reasons=[];
    if(riskReduction>=20) reasons.push(`可降低目標站 30 分鐘缺車風險（${riskBefore}% → ${sim.targetRisk30}%）`);
    if(stability>=40) reasons.push(`預估可維持約 ${stability} 分鐘`);
    else if(stability>0) reasons.push(`僅能短暫改善（約 ${stability} 分鐘）`);
    if(feasibleBikes && effectiveAvail(source)-bikes>=safeReserve(source)) reasons.push('來源站仍高於安全庫存');
    reasons.push(`ETA ${dispatchService.eta(source,target)} 分鐘`);
    if(sourceBecomesHigh) reasons.push('⚠ 可能造成來源站缺車');
    if(!feasibleBikes) reasons.push('⚠ 來源站可調度量不足');

    let verdict = 'ok';
    if(!feasible) verdict='blocked';
    return { sim, score, feasible, feasibleBikes, sourceBecomesHigh, verdict, reasons,
             riskBefore, riskReduction, stability, sourceRiskIncrease };
  }
};
function simulateDispatch(target, source, bikes){ return simulationService.simulateDispatch(target, source, bikes); }
function calculateDispatchBenefit(target, source, bikes){ return simulationService.calculateDispatchBenefit(target, source, bikes); }

function riskLevelClass(r){ return r>=65?'high':r>=35?'med':'low'; }

/* =====================================================================
   INTERVENTION DECISION ENGINE  (Phase 3)
   -------------------------------------------------------------------
   Turns 友愛接力 (Community Relay) into a first-class intervention that
   COMPETES with fleet dispatch. The engine answers:
     「這個問題應該由誰解決 — 民眾（友愛接力）還是車隊？」

   Key principle: low usage alone is NOT a relay trigger. A relay is only
   recommended when there is a PREDICTED imbalance that community behaviour
   can plausibly improve, AND relay improvement is enough (else HYBRID/FLEET).

   All numbers are DEMO estimates (predictionService.source==='mock').
   ===================================================================== */

// Is the station enrolled / eligible for the community-relay activity? (DEMO flag)
function relayActivityEligible(s){
  // eligibility comes from activity enrolment, not from being low-usage.
  // Demo: all managed stations are enrolled unless explicitly opted out.
  return s.relayEnrolled !== false;
}

// Relay improvement potential (0..1): how much community behaviour could realistically help.
// Depends on how much "room" the opposite side has (docks for RETURN, bikes for BORROW)
// and the station's footfall (capacity as a proxy for how many users pass by).
function relayImprovementPotential(s, direction){
  const cap = Math.max(1, s.cap||1);
  const footfall = Math.min(1, cap/34);                  // bigger station => more passing users
  let room;
  if(direction==='RETURN')      room = Math.min(1, (s.empty ?? 0)/cap);        // need docks to accept returns
  else if(direction==='BORROW') room = Math.min(1, effectiveAvail(s)/cap);     // need bikes to lend out
  else                          room = 0.4;
  // realistic ceiling: relay is a soft nudge, not a truck
  return Math.max(0, Math.min(0.6, footfall*0.5 + room*0.5)) ;
}

/* calculateRelayScore(station) -> 0..100
   Composed (non-random) from predicted risk, imbalance duration, improvement
   potential, capacity, current effective supply and activity eligibility. */
function calculateRelayScore(s){
  const pred = getPrediction(s);
  const cap = Math.max(1, s.cap||1);
  // determine the risk-relevant direction first
  const dir = relayDirection(s);
  if(dir===null) return 0;
  const predictedRisk = dir==='RETURN' ? pred.risk30 : (1 - pred.predictedEmptyDockRatio30); // 0..1
  const dur = Math.min(imbalanceDuration(s),120)/120;
  const potential = relayImprovementPotential(s, dir);          // 0..0.6
  const capScore = Math.min(cap,40)/40;
  const supplyTight = dir==='RETURN'
      ? 1-Math.min(1, effectiveAvail(s)/Math.max(6,cap*0.25))
      : 1-Math.min(1, (s.empty??0)/Math.max(6,cap*0.25));
  const eligible = relayActivityEligible(s) ? 1 : 0;

  let score = 100*( predictedRisk*0.40 + supplyTight*0.18 + potential*0.20 + dur*0.10 + capScore*0.07 + eligible*0.05 );
  return Math.max(0, Math.min(100, Math.round(score)));
}

// Which way should relay push? RETURN (encourage returns) if shortage risk,
// BORROW (encourage borrowing) if full-dock risk, else null.
function relayDirection(s){
  const pred = getPrediction(s);
  const shortageRisk = pred.risk30;                                              // low predicted available
  const fullRisk = Math.min(0.95, riskFromSupply((s.cap||1)*pred.predictedEmptyDockRatio30, s.cap)/100); // low predicted empty docks
  const SH=0.55, FU=0.55;
  if(shortageRisk>=SH && fullRisk>=FU) return 'BOTH';
  if(shortageRisk>=SH) return 'RETURN';
  if(fullRisk>=FU)     return 'BORROW';
  return null;
}

/* decideIntervention(station) -> {type,direction,score,reason,expectedImpact,confidence}
   type: 'RELAY' | 'FLEET' | 'HYBRID' | 'NONE'
   Every station gets a valid object (fallback = NONE). */
function decideIntervention(s){
  const pred = getPrediction(s);
  const risk30 = pred.risk30;                                  // 0..1 shortage risk
  const fullRisk30 = Math.min(0.95, riskFromSupply((s.cap||1)*pred.predictedEmptyDockRatio30, s.cap)/100); // 0..0.95 full-dock risk
  const dir = relayDirection(s);
  const dur = imbalanceDuration(s);
  const conf = pred.confidence;

  // no meaningful current/future risk -> NONE (do NOT flag naturally-quiet stations)
  const peakRisk = Math.max(risk30, fullRisk30);
  if(peakRisk < 0.5 && dir===null){
    return {type:'NONE', direction:null, score:0, reason:'目前與未來 30 分鐘皆無明顯供需風險。',
            expectedImpact:0, confidence:conf, relayScore:0, fleetRisk:Math.round(peakRisk*100)};
  }

  const relayScore = calculateRelayScore(s);
  const effDir = dir==='BOTH' ? (risk30>=fullRisk30?'RETURN':'BORROW') : dir;
  const potential = effDir? relayImprovementPotential(s, effDir) : 0;   // 0..0.6
  const peakPct = Math.round(peakRisk*100);
  const relayImpact = Math.round(peakPct * potential);                  // pp it could cut (DEMO)

  // "room" = absolute capacity for community behaviour to help in the risk direction.
  //   RETURN needs empty docks (so people can return); BORROW needs bikes (so people can borrow).
  const cap = Math.max(1, s.cap||1);
  const room = effDir==='RETURN' ? (s.empty ?? 0)
             : effDir==='BORROW' ? effectiveAvail(s)
             : 0;
  const roomRatio = room/cap;
  const roomEnough = room>=6 && roomRatio>=0.30;      // enough physical room for a relay nudge
  // "severe" only when risk is extreme AND community behaviour has little room to help
  const severe = peakRisk>=0.88 && !roomEnough;
  const longImbalance = dur>=60;

  let type, reason, expectedImpact;
  if(peakRisk<0.5 && dir===null){
    type='NONE'; expectedImpact=0;
    reason='風險偏低，暫不需要主動介入。';
  } else if(severe || longImbalance || !roomEnough){
    // extreme risk, sustained imbalance, or no physical room for community behaviour -> fleet
    // BUT if there IS some room, keep relay running alongside (HYBRID) rather than pure FLEET.
    if(roomEnough && !severe){
      type='HYBRID'; expectedImpact=relayImpact;
      reason=`預測風險 ${peakPct}%，友愛接力可先降低部分風險，但可能不足，建議同時準備車隊。`;
    } else {
      type='FLEET'; expectedImpact=0;
      reason=`預測風險 ${peakPct}%，${!roomEnough?'站點缺乏可供民眾行為改善的空間':'失衡嚴重且持續'}，預估友愛接力改善不足，建議車隊調度。`;
    }
  } else if(roomEnough && peakRisk<0.86){
    type='RELAY'; expectedImpact=relayImpact;
    reason=`預測風險 ${peakPct}%，站點仍有${effDir==='BORROW'?'足夠車輛':'足夠空位'}，民眾行為具改善空間，優先採用友愛接力。`;
  } else {
    type='HYBRID'; expectedImpact=relayImpact;
    reason=`預測風險 ${peakPct}%，友愛接力可先降低部分風險，但可能不足，建議同時準備車隊。`;
  }

  return {
    type,
    direction: type==='FLEET' ? null : (dir==='BOTH'? (risk30>=fullRisk30?'RETURN':'BORROW') : dir),
    score: relayScore,
    reason,
    expectedImpact,                       // percentage-point risk reduction (DEMO)
    confidence: conf,
    relayScore,
    fleetRisk: Math.round(peakRisk*100),
    peakRiskPct: Math.round(peakRisk*100)
  };
}

// refresh derived AI fields on a station (prediction + intervention). Always safe.
function refreshStationAI(s){
  computeStationPrediction(s);
  s.relayScore = calculateRelayScore(s);
  s.relayDirection = relayDirection(s);
  s.intervention = decideIntervention(s);
  s.expectedImpact = s.intervention.expectedImpact;
  if(typeof ADDON!=='undefined'){
    try{ ADDON.enrichStation(s); }catch(e){}
  }
  return s;
}
function refreshAllAI(){ DATA.stations.forEach(refreshStationAI); }

// human labels for intervention
function interventionLabel(t){
  return t==='RELAY'?'友愛接力': t==='FLEET'?'車隊調度': t==='HYBRID'?'混合策略':'正常';
}
function interventionTag(t){
  return t==='RELAY'?'RELAY': t==='FLEET'?'FLEET': t==='HYBRID'?'HYBRID':'NONE';
}
function directionLabel(d){
  return d==='RETURN'?'建議還車到此站': d==='BORROW'?'建議從此站借車': d==='BOTH'?'可借可還皆有助益':'';
}

// derive priority "calls" from stations that need attention.
// Now sorted by Decision-Engine priorityScore (not just HIGH/MED/LOW).
function buildCalls(){
  refreshAllAI();   // ensure every station has fresh prediction + intervention
  return DATA.stations
    // include anything with a status issue, a suspected fault, OR a predicted intervention
    .filter(s => s.status !== 'normal' || (s.suspectedFault ?? 0) > 0 || (s.intervention && s.intervention.type!=='NONE'))
    .map(s => {
      const anom = detectVehicleAnomaly(s);
      const pr = calculateDispatchPriority(s);
      const iv = s.intervention || decideIntervention(s);
      // intervention urgency nudges priority (only when there IS an intervention)
      const urgency = iv.type==='FLEET'?10 : iv.type==='HYBRID'?7 : iv.type==='RELAY'?4 : 0;
      const priorityScore = Math.min(100, pr.score + urgency);
      return {
        stationId:s.id, name:s.name, issue:s.issue, waitMin:s.waitMin,
        prio:s.prio, status:s.status,
        duration: `${Math.round(s.waitMin*0.7)} MIN 前回報`,
        anomaly: anom,
        reportedAvail: (s.reportedAvail ?? s.avail),
        effectiveAvail: effectiveAvail(s),
        suspectedFault: (s.suspectedFault ?? 0),
        longestIdleMin: (s.longestIdleMin ?? 0),
        // phase-2 metrics
        risk30: pr.risk30,
        priorityScore,
        priorityReason: pr.reason,
        imbalanceDuration: imbalanceDuration(s),
        // phase-3 intervention
        intervention: iv
      };
    })
    .sort((a,b)=> b.priorityScore - a.priorityScore || b.risk30 - a.risk30);
}

const STATE = {
  view:'operations',        // 'operations' | 'public'
  selectedId:null,          // ops selected station
  detailMode:'detail',      // ops right panel: 'detail' | 'reco'
  routeAnim:0, calls:buildCalls(),
  // public view state
  pubSelectedId:null,
  pubNav:null,              // {from, to, meters, min} mock navigation
  pubRouteAnim:0
};

// mock user location (isometric grid coords) — used for public navigation
const USER_LOC = { gx:3.2, gy:3.4 };

/* =====================================================================
   ISOMETRIC CITY MAP  (canvas)
   ===================================================================== */
const canvas = document.getElementById('mapCanvas');
const ctx = canvas.getContext('2d');
let W=0,H=0, DPR=Math.min(window.devicePixelRatio||1,2);
let ORIGIN={x:0,y:0};
const TILE = {w:74, h:37};       // iso tile footprint
const GRID = {cols:8, rows:10};

function resize(){
  const r = canvas.parentElement.getBoundingClientRect();
  W=r.width; H=r.height;
  canvas.width=W*DPR; canvas.height=H*DPR;
  canvas.style.width=W+'px'; canvas.style.height=H+'px';
  ctx.setTransform(DPR,0,0,DPR,0,0);
  // center the iso grid
  ORIGIN.x = W/2 - 10;
  ORIGIN.y = H/2 - (GRID.rows*TILE.h)/2 + 20;
}
function iso(gx,gy){
  return {
    x: ORIGIN.x + (gx-gy)*TILE.w/2,
    y: ORIGIN.y + (gx+gy)*TILE.h/2
  };
}

// deterministic pseudo-random per tile for building heights / roads
function rnd(a,b){ const s=Math.sin(a*127.1+b*311.7)*43758.5453; return s-Math.floor(s); }

// map cell types
const RIVER_CELLS = new Set(['7,0','7,1','6,2','6,3','5,3','5,4','4,4','4,5','7,2']);
const ROAD_ROWS = [3,7]; const ROAD_COLS=[1,5];
function cellType(gx,gy){
  if(RIVER_CELLS.has(gx+','+gy)) return 'river';
  if(ROAD_ROWS.includes(gy)||ROAD_COLS.includes(gx)) return 'road';
  return 'block';
}

function drawTileTop(gx,gy,fill,stroke){
  const p=iso(gx,gy);
  ctx.beginPath();
  ctx.moveTo(p.x, p.y);
  ctx.lineTo(p.x+TILE.w/2, p.y+TILE.h/2);
  ctx.lineTo(p.x, p.y+TILE.h);
  ctx.lineTo(p.x-TILE.w/2, p.y+TILE.h/2);
  ctx.closePath();
  ctx.fillStyle=fill; ctx.fill();
  if(stroke){ ctx.strokeStyle=stroke; ctx.lineWidth=1; ctx.stroke(); }
}

function drawBuilding(gx,gy){
  const p=iso(gx,gy);
  const cx=p.x, cyTop=p.y;
  const seed=rnd(gx,gy);
  const seed2=rnd(gy,gx);
  const h = 14 + seed*40;         // building height
  const inset = 9 + seed2*7;      // footprint inset
  const w = TILE.w/2 - inset;
  const d = TILE.h/2 - inset*0.5;
  const topY = cyTop + TILE.h/2 - h;
  // walls
  const leftFace='#232830', rightFace='#1b1f26', roof='#2e343d';
  // left wall
  ctx.beginPath();
  ctx.moveTo(cx-w, cyTop+TILE.h/2 - d + h - h);
  // recompute cleaner:
  const bx=cx, byBase=cyTop+TILE.h/2;
  const tl={x:bx-w, y:byBase-d}, tr={x:bx+w,y:byBase-d}, bmid={x:bx,y:byBase+d? byBase - d:byBase};
  // Simpler box: base diamond center at (bx,byBase)
  const topOff=h;
  const bTop={x:bx, y:byBase-d-topOff}, bRight={x:bx+w,y:byBase-topOff}, bBot={x:bx,y:byBase+d-topOff}, bLeft={x:bx-w,y:byBase-topOff};
  const gTop={x:bx, y:byBase-d}, gRight={x:bx+w,y:byBase}, gBot={x:bx,y:byBase+d}, gLeft={x:bx-w,y:byBase};
  // left face
  ctx.beginPath();
  ctx.moveTo(bLeft.x,bLeft.y);ctx.lineTo(bBot.x,bBot.y);ctx.lineTo(gBot.x,gBot.y);ctx.lineTo(gLeft.x,gLeft.y);ctx.closePath();
  ctx.fillStyle=leftFace;ctx.fill();
  // right face
  ctx.beginPath();
  ctx.moveTo(bBot.x,bBot.y);ctx.lineTo(bRight.x,bRight.y);ctx.lineTo(gRight.x,gRight.y);ctx.lineTo(gBot.x,gBot.y);ctx.closePath();
  ctx.fillStyle=rightFace;ctx.fill();
  // roof
  ctx.beginPath();
  ctx.moveTo(bTop.x,bTop.y);ctx.lineTo(bRight.x,bRight.y);ctx.lineTo(bBot.x,bBot.y);ctx.lineTo(bLeft.x,bLeft.y);ctx.closePath();
  ctx.fillStyle=roof;ctx.fill();
  ctx.strokeStyle='rgba(0,0,0,.35)';ctx.lineWidth=1;ctx.stroke();
  // faint window line on right face
  if(seed>0.4){
    ctx.strokeStyle='rgba(183,173,153,.06)';
    ctx.beginPath();
    ctx.moveTo(bBot.x,bBot.y-4);ctx.lineTo(bRight.x,bRight.y-4);ctx.stroke();
  }
}

function drawGround(){
  // base ground tiles back-to-front
  for(let gy=0; gy<GRID.rows; gy++){
    for(let gx=0; gx<GRID.cols; gx++){
      const t=cellType(gx,gy);
      let fill='#1a1e25';
      if(t==='river') fill='#1e2b33';
      else if(t==='road') fill='#20242b';
      else fill = (gx+gy)%2? '#181c22':'#1b1f26';
      drawTileTop(gx,gy,fill,'rgba(0,0,0,.25)');
      // road markings
      if(t==='road'){
        const p=iso(gx,gy);
        ctx.strokeStyle='rgba(183,173,153,.10)';
        ctx.setLineDash([4,5]);
        ctx.beginPath();ctx.moveTo(p.x-TILE.w/4,p.y+TILE.h*0.75);ctx.lineTo(p.x+TILE.w/4,p.y+TILE.h*0.25);ctx.stroke();
        ctx.setLineDash([]);
      }
      // river ripple
      if(t==='river'){
        const p=iso(gx,gy);
        ctx.strokeStyle='rgba(120,150,160,.10)';
        ctx.beginPath();ctx.moveTo(p.x-10,p.y+TILE.h/2);ctx.quadraticCurveTo(p.x,p.y+TILE.h/2-4,p.x+10,p.y+TILE.h/2);ctx.stroke();
      }
    }
  }
  // bridge across river (a lighter deck between land cells)
  const bridges=[['6,2','5,3'],['5,4','4,5']];
  ctx.strokeStyle='rgba(183,173,153,.28)';ctx.lineWidth=6;
  bridges.forEach(([a,b])=>{
    const [ax,ay]=a.split(',').map(Number),[bx,by]=b.split(',').map(Number);
    const pa=iso(ax,ay),pb=iso(bx,by);
    ctx.beginPath();ctx.moveTo(pa.x,pa.y+TILE.h/2);ctx.lineTo(pb.x,pb.y+TILE.h/2);ctx.stroke();
  });
  ctx.lineWidth=1;
}

function drawBuildings(){
  for(let gy=0; gy<GRID.rows; gy++){
    for(let gx=0; gx<GRID.cols; gx++){
      const t=cellType(gx,gy);
      if(t==='block'){
        // skip cells occupied by a station (draw a plaza there)
        const occ=DATA.stations.some(s=>s.gx===gx&&s.gy===gy);
        if(occ) continue;
        if(rnd(gx*3.1,gy*1.7)>0.28) drawBuilding(gx,gy);
      }
    }
  }
}

function statusColor(st){
  return st==='critical'?'#b23c34': st==='warning'?'#c07b39':'#6f8f5f';
}
// Operations marker color reflects the AI INTERVENTION type (fleet/relay/hybrid/normal)
function interventionColor(s){
  const t=(s.intervention&&s.intervention.type)||'NONE';
  return t==='FLEET'?'#b23c34': t==='HYBRID'?'#c07b39': t==='RELAY'?'#c2a63c':'#6f8f5f';
}
function interventionGlyph(t){
  return t==='FLEET'?'!' : t==='RELAY'?'♻' : t==='HYBRID'?'◑' : '';
}

let pulse=0;
function drawMarker(s){
  const p=iso(s.gx,s.gy);
  const baseY=p.y+TILE.h/2;
  const selected = STATE.selectedId===s.id;
  const ivType=(s.intervention&&s.intervention.type)||'NONE';
  const col=interventionColor(s);
  const big = ivType==='FLEET' || s.status==='critical' || selected;
  const r = big?12:7;
  // pole shadow on ground
  ctx.fillStyle='rgba(0,0,0,.35)';
  ctx.beginPath();ctx.ellipse(p.x,baseY,10,4,0,0,Math.PI*2);ctx.fill();

  // pulse ring for fleet-intervention / critical / selected
  if(ivType==='FLEET' || s.status==='critical' || selected){
    const pr = r + 6 + Math.sin(pulse)*6 + 6;
    ctx.strokeStyle = selected? 'rgba(183,173,153,'+(0.5-0.4*Math.abs(Math.sin(pulse)))+')' : 'rgba(178,60,52,'+(0.5-0.4*Math.abs(Math.sin(pulse)))+')';
    ctx.lineWidth=2;
    ctx.beginPath();ctx.arc(p.x,baseY-28,pr,0,Math.PI*2);ctx.stroke();
  }

  const pinY = baseY-28;
  // pin stem
  ctx.strokeStyle='rgba(0,0,0,.5)';ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(p.x,baseY);ctx.lineTo(p.x,pinY);ctx.stroke();
  // pin teardrop
  ctx.beginPath();
  ctx.arc(p.x,pinY,r,0,Math.PI*2);
  ctx.fillStyle = selected? '#d8cdb4' : col;
  ctx.fill();
  ctx.strokeStyle = selected? '#fff':'rgba(0,0,0,.6)';ctx.lineWidth = selected?2:1.5;ctx.stroke();
  // point
  ctx.beginPath();ctx.moveTo(p.x-r*0.5,pinY+r*0.7);ctx.lineTo(p.x,pinY+r+5);ctx.lineTo(p.x+r*0.5,pinY+r*0.7);ctx.closePath();ctx.fillStyle=ctx.fillStyle;ctx.fill();
  // glyph reflects intervention type (fleet ! / relay ♻ / hybrid ◑)
  const glyph=interventionGlyph(ivType);
  if(selected){
    ctx.fillStyle='#16191f';ctx.font='bold 11px Oswald';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText('◆',p.x,pinY);
  } else if(glyph){
    ctx.fillStyle = ivType==='RELAY'||ivType==='HYBRID' ? '#16191f' : '#fff';
    ctx.font='bold 12px Oswald';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(glyph,p.x,pinY);
  }
  // label
  ctx.font='11px "Noto Sans TC"';ctx.textAlign='center';ctx.textBaseline='top';
  const label=s.name;
  const tw=ctx.measureText(label).width;
  ctx.fillStyle='rgba(18,21,26,.78)';
  ctx.fillRect(p.x-tw/2-5,pinY+r+7,tw+10,15);
  ctx.fillStyle = selected? '#e8e2d5' : '#b7ad99';
  ctx.fillText(label,p.x,pinY+r+9);
}

// dispatch route drawn from source station -> target (selected) station
let ROUTE=null; // {from:station, to:station, bikes, min, km}
function drawRoute(){
  if(!ROUTE) return;
  const a=iso(ROUTE.from.gx,ROUTE.from.gy), b=iso(ROUTE.to.gx,ROUTE.to.gy);
  const ax=a.x, ay=a.y+TILE.h/2-28, bx=b.x, by=b.y+TILE.h/2-28;
  const mx=(ax+bx)/2, my=Math.min(ay,by)-46;
  const t=Math.min(STATE.routeAnim,1);
  // sample quadratic bezier up to t
  ctx.strokeStyle='rgba(178,60,52,.9)';ctx.lineWidth=3;ctx.setLineDash([7,6]);ctx.lineDashOffset=-pulse*6;
  ctx.beginPath();ctx.moveTo(ax,ay);
  const steps=40;
  for(let i=1;i<=steps*t;i++){
    const u=i/steps;
    const x=(1-u)*(1-u)*ax+2*(1-u)*u*mx+u*u*bx;
    const y=(1-u)*(1-u)*ay+2*(1-u)*u*my+u*u*by;
    ctx.lineTo(x,y);
  }
  ctx.stroke();ctx.setLineDash([]);
  // moving bike token along route
  if(t>=1){
    const u=(pulse*0.12)%1;
    const x=(1-u)*(1-u)*ax+2*(1-u)*u*mx+u*u*bx;
    const y=(1-u)*(1-u)*ay+2*(1-u)*u*my+u*u*by;
    ctx.fillStyle='#e8e2d5';ctx.beginPath();ctx.arc(x,y,4,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle='#b23c34';ctx.lineWidth=1.5;ctx.stroke();
  }
  // endpoints
  [[ax,ay,'#c07b39','SOURCE'],[bx,by,'#b23c34','TARGET']].forEach(([x,y,c,tag])=>{
    ctx.fillStyle=c;ctx.beginPath();ctx.arc(x,y,5,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#e8e2d5';ctx.font='700 9px Oswald';ctx.textAlign='center';
    ctx.fillText(tag,x,y-12);
  });
}

function render(){
  ctx.clearRect(0,0,W,H);
  drawGround();
  drawBuildings();
  // markers sorted back-to-front
  const sorted=[...DATA.stations].sort((a,b)=>(a.gx+a.gy)-(b.gx+b.gy));
  sorted.forEach(drawMarker);
  drawRoute();
}

function loop(){
  pulse+=0.06;
  if(ROUTE && STATE.routeAnim<1) STATE.routeAnim=Math.min(1,STATE.routeAnim+0.04);
  if(STATE.pubNav && STATE.pubRouteAnim<1) STATE.pubRouteAnim=Math.min(1,STATE.pubRouteAnim+0.04);
  if(STATE.view==='operations'){ render(); }
  else { pubRenderMap(); }
  requestAnimationFrame(loop);
}

// click detection on markers
canvas.addEventListener('click',e=>{
  const r=canvas.getBoundingClientRect();
  const mx=e.clientX-r.left, my=e.clientY-r.top;
  let hit=null,best=1e9;
  DATA.stations.forEach(s=>{
    const p=iso(s.gx,s.gy);const px=p.x,py=p.y+TILE.h/2-28;
    const d=Math.hypot(mx-px,my-py);
    if(d<20&&d<best){best=d;hit=s;}
  });
  if(hit){ selectStation(hit.id); }
});

