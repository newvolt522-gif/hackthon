  if(!PLAN) return;
  const plan=PLAN.plans.find(p=>p.key===PLAN.selectedKey);
  const src=PLAN.source, tgt=PLAN.target;
  const km=dispatchService.km(src,tgt), min=dispatchService.eta(src,tgt);
  ROUTE={from:src, to:tgt, bikes:plan.bikes, min, km:km.toFixed(1)};
  STATE.routeAnim=0;
  document.getElementById('rr-nodes').textContent=`${src.name} → ${tgt.name}`;
  document.getElementById('rr-bikes').textContent=plan.bikes;
  document.getElementById('rr-time').textContent=min;
  document.getElementById('rr-dist').textContent=km.toFixed(1);
  document.getElementById('route-readout').classList.add('on');
}
