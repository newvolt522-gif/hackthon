    {id:'0091', name:'中和環球站',   gx:6, gy:8,  status:'normal',   issue:'運作正常',     avail:15, reportedAvail:15, suspectedFault:0, longestIdleMin:0,   empty:9,  cap:24, waitMin:0,  prio:'LOW',  district:'中和區', faultConfirmed:false, delta30:1,  delta60:0,  deltaEmpty30:-1, deltaEmpty60:0,  imbalanceDuration:0,  importance:1.0},
