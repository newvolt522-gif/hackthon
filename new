<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YOUBIKE DISPATCH CONTROL — 新北市交通局派遣作戰室</title>
<style>
/* ============================================================
   YOUBIKE DISPATCH CONTROL ROOM
   Visual direction: "This Is the Police" tactical control room
   Dark editorial / graphic-novel / retro dispatch aesthetic
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Noto+Sans+TC:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500;700&display=swap');

:root{
  /* base neutrals */
  --navy:        #16191f;   /* deep charcoal navy */
  --navy-2:      #1c2027;
  --panel:       #21252d;
  --panel-2:     #262b34;
  --panel-line:  #33383f;
  --warm-gray:   #6f6a60;
  --beige:       #b7ad99;
  --muted-beige: #8f8778;
  --offwhite:    #e8e2d5;
  --ink:         #cfc9bc;
  --ink-dim:     #8b877c;

  /* alert colors (muted, editorial) */
  --critical:    #b23c34;   /* dark red */
  --critical-2:  #d9564a;
  --warning:     #c07b39;   /* muted orange */
  --attention:   #c2a63c;   /* muted yellow */
  --normal:      #6f8f5f;   /* muted green */
  --normal-2:    #86a56e;

  --grid-line:   rgba(183,173,153,0.05);
}

*{margin:0;padding:0;box-sizing:border-box}

html,body{height:100%}
body{
  background:
    repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.12) 3px, rgba(0,0,0,0.12) 4px),
    radial-gradient(ellipse at 50% 0%, #22262e 0%, var(--navy) 60%, #101216 100%);
  color:var(--ink);
  font-family:'Noto Sans TC','Oswald',sans-serif;
  overflow:hidden;
  height:100vh;
  letter-spacing:.02em;
}

.label{font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:.14em;font-weight:500}
.mono{font-family:'JetBrains Mono',monospace}

/* ===== app grid ===== */
#app{
  display:grid;
  grid-template-columns: 20% 55% 25%;
  grid-template-rows: 46px 1fr 168px;
  grid-template-areas:
    "top    top    top"
    "left   center right"
    "left   bottom right";
  height:100vh;
  gap:1px;
  background:#0c0d10;
}

/* ===== top bar ===== */
#topbar{
  grid-area:top;
  background:linear-gradient(180deg,#20242c,#191c22);
  border-bottom:2px solid var(--critical);
  display:flex;align-items:center;
  padding:0 16px;gap:18px;
  box-shadow:0 2px 0 rgba(0,0,0,.4);
}
#topbar .brand{display:flex;align-items:center;gap:10px}
#topbar .sigil{
  width:26px;height:26px;border:2px solid var(--beige);
  display:flex;align-items:center;justify-content:center;
  color:var(--beige);font-weight:700;font-family:'Oswald';
  transform:rotate(45deg);font-size:12px;
}
#topbar .sigil span{transform:rotate(-45deg)}
#topbar h1{font-family:'Oswald';font-size:15px;letter-spacing:.22em;color:var(--offwhite);text-transform:uppercase;font-weight:600}
#topbar .sub{font-size:11px;color:var(--ink-dim);letter-spacing:.1em}
#topbar .spacer{flex:1}
.top-stat{display:flex;flex-direction:column;align-items:flex-end;line-height:1.1;padding:0 12px;border-left:1px solid var(--panel-line)}
.top-stat .k{font-size:9px;color:var(--ink-dim);letter-spacing:.14em}
.top-stat .v{font-family:'Oswald';font-size:17px;color:var(--offwhite);font-weight:600}
.top-stat .v.crit{color:var(--critical-2)}
.top-stat .v.warn{color:var(--warning)}
#clock{font-family:'JetBrains Mono';font-size:16px;color:var(--beige);letter-spacing:.06em;min-width:82px;text-align:right}

/* ===== panel chrome shared ===== */
.panel{background:var(--panel);position:relative;overflow:hidden;display:flex;flex-direction:column}
.panel-head{
  display:flex;align-items:center;gap:8px;
  padding:9px 12px;
  background:linear-gradient(180deg,#282d36,#20242b);
  border-bottom:1px solid var(--panel-line);
  flex:0 0 auto;
}
.panel-head .dot{width:7px;height:7px;background:var(--critical);transform:rotate(45deg)}
.panel-head h2{font-family:'Oswald';font-size:12.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--offwhite);font-weight:600}
.panel-head .count{margin-left:auto;font-family:'JetBrains Mono';font-size:12px;color:var(--beige);background:#14161b;padding:1px 7px;border:1px solid var(--panel-line)}
.panel-body{flex:1;overflow-y:auto;overflow-x:hidden}

/* scrollbar */
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:#14161b}
::-webkit-scrollbar-thumb{background:#3a3f47;border:1px solid #14161b}
::-webkit-scrollbar-thumb:hover{background:#4a505a}

/* ===== LEFT : PRIORITY CALLS ===== */
#left{grid-area:left;border-right:1px solid #0c0d10}
.call{
  padding:11px 12px 12px;border-bottom:1px solid var(--panel-line);
  cursor:pointer;position:relative;transition:background .15s;
  border-left:3px solid transparent;
}
.call:hover{background:var(--panel-2)}
.call.selected{background:#2c2018;border-left-color:var(--critical)}
.call .row1{display:flex;align-items:center;gap:8px}
.call .pin{width:12px;height:12px;flex:0 0 auto;border-radius:50%}
.call .name{font-weight:700;font-size:14px;color:var(--offwhite);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.call .prio{font-family:'Oswald';font-size:10px;letter-spacing:.12em;padding:1px 6px;font-weight:600}
.call .issue{font-size:12px;color:var(--ink);margin:5px 0 6px;padding-left:20px}
.call .meta{display:flex;gap:14px;padding-left:20px;align-items:baseline}
.call .meta .t{font-family:'JetBrains Mono';font-size:16px;color:var(--offwhite);font-weight:500}
.call .meta .t small{font-size:9px;color:var(--ink-dim);letter-spacing:.1em}
.call .meta .dur{font-size:10px;color:var(--ink-dim);letter-spacing:.1em}

/* anomaly call card */
.call.anomaly{border-left-color:var(--critical);background:#241a18}
.call.anomaly.selected{background:#2c2018}
.call .anom-flag{font-size:13px;flex:0 0 auto;animation:flick 1.8s infinite}
.call .issue.anom-issue{color:var(--critical-2);font-weight:700;padding-left:0;letter-spacing:.04em}
.call .anom-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;margin-top:6px}
.call .anom-grid > div{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px dotted var(--panel-line);padding-bottom:2px}
.call .anom-grid .al{font-size:10px;color:var(--ink-dim);letter-spacing:.06em}
.call .anom-grid .av{font-family:'JetBrains Mono';font-size:14px;color:var(--offwhite);font-weight:500}
.call .anom-grid .av.bad{color:var(--critical-2)}
.call .anom-grid .av.good{color:var(--normal-2)}

/* per-call risk/duration/priority metrics row */
.call-metrics{display:flex;gap:6px;margin-top:8px;padding-left:20px}
.call.anomaly .call-metrics{padding-left:0}
.call-metrics .cm{flex:1;background:#181b21;border:1px solid var(--panel-line);padding:4px 6px;display:flex;flex-direction:column;align-items:center;gap:1px}
.call-metrics .cml{font-size:8px;color:var(--ink-dim);letter-spacing:.08em}
.call-metrics .cmv{font-family:'JetBrains Mono';font-size:13px;color:var(--offwhite);font-weight:600}
.call-metrics .cmv.risk-high{color:var(--critical-2)}
.call-metrics .cmv.risk-med{color:var(--warning)}
.call-metrics .cmv.risk-low{color:var(--normal-2)}
.call-metrics .cmv.prio-score{color:var(--beige)}
.call-metrics .cmv.imb{color:var(--warning)}

/* intervention badge row on call cards */
.call-iv{display:flex;align-items:center;gap:8px;margin-top:8px;padding-left:20px}
.call.anomaly .call-iv{padding-left:0}
.call-iv .ivt{font-family:'Oswald';font-size:9px;letter-spacing:.12em;font-weight:700;padding:2px 7px;flex:0 0 auto}
.call-iv .ivl{font-size:11px;color:var(--ink);letter-spacing:.02em}
.iv-RELAY .ivt{background:var(--attention);color:#16191f}
.iv-FLEET .ivt{background:var(--critical);color:#fff}
.iv-HYBRID .ivt{background:var(--warning);color:#16191f}
.iv-RELAY .ivl{color:var(--attention)}
.iv-FLEET .ivl{color:var(--critical-2)}
.iv-HYBRID .ivl{color:var(--warning)}

.prio-HIGH{background:var(--critical);color:#fff}
.prio-MED{background:var(--warning);color:#1a1206}
.prio-LOW{background:var(--attention);color:#1a1206}
.pin-critical{background:var(--critical);box-shadow:0 0 0 3px rgba(178,60,52,.25)}
.pin-warning{background:var(--warning)}
.pin-normal{background:var(--normal)}

/* ===== CENTER : MAP ===== */
#center{grid-area:center;background:#12151a;position:relative;overflow:hidden}
#mapCanvas{display:block;width:100%;height:100%}
.map-overlay{position:absolute;pointer-events:none}
#map-title{top:12px;left:14px}
#map-title .t1{font-family:'Oswald';font-size:13px;letter-spacing:.24em;color:var(--offwhite);text-transform:uppercase}
#map-title .t2{font-size:11px;color:var(--ink-dim);letter-spacing:.1em;margin-top:2px}
#map-legend{bottom:12px;left:14px;display:flex;flex-direction:column;gap:5px;background:rgba(18,21,26,.75);border:1px solid var(--panel-line);padding:8px 10px}
#map-legend .lg{display:flex;align-items:center;gap:7px;font-size:10px;letter-spacing:.08em;color:var(--ink)}
#map-legend .lg i{width:10px;height:10px;border-radius:50%;display:inline-block}
#map-legend .lg-h{font-family:'Oswald';font-size:9px;letter-spacing:.14em;color:var(--beige);margin-bottom:2px}
/* AI prediction KPI mini-panel */
#ai-kpi{top:66px;right:14px;background:rgba(18,21,26,.82);border:1px solid var(--panel-line);padding:9px 11px;width:172px}
#ai-kpi .kpi-h{font-family:'Oswald';font-size:10px;letter-spacing:.14em;color:var(--offwhite);text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center}
#ai-kpi .kpi-demo{margin-left:auto;font-size:7px;background:var(--attention);color:#16191f;padding:1px 5px;letter-spacing:.08em}
#ai-kpi .kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 8px}
#ai-kpi .kpi-grid > div{display:flex;flex-direction:column;align-items:center;background:#14161b;border:1px solid var(--panel-line);padding:5px 2px}
#ai-kpi .kv{font-family:'Oswald';font-size:19px;font-weight:600;color:var(--beige);line-height:1}
#ai-kpi .kk{font-size:8px;color:var(--ink-dim);letter-spacing:.04em;margin-top:2px}
#ai-kpi .kpi-foot{font-size:9px;color:var(--ink-dim);margin-top:8px;line-height:1.5;letter-spacing:.02em}
#map-compass{top:12px;right:14px;width:44px;height:44px;border:1px solid var(--panel-line);background:rgba(18,21,26,.7);display:flex;align-items:center;justify-content:center;color:var(--beige);font-family:'Oswald';font-size:11px;letter-spacing:.1em}
#route-readout{
  bottom:12px;right:14px;background:rgba(18,21,26,.9);border:1px solid var(--critical);
  padding:9px 13px;display:none;
}
#route-readout.on{display:block;animation:fadeIn .3s ease}
#route-readout .rr-h{font-family:'Oswald';font-size:10px;letter-spacing:.16em;color:var(--critical-2);text-transform:uppercase}
#route-readout .rr-nodes{font-size:12px;color:var(--offwhite);margin:4px 0;font-weight:700}
#route-readout .rr-stats{display:flex;gap:16px}
#route-readout .rr-stats div{text-align:center}
#route-readout .rr-stats .n{font-family:'JetBrains Mono';font-size:16px;color:var(--beige)}
#route-readout .rr-stats .k{font-size:8px;color:var(--ink-dim);letter-spacing:.1em}

/* ===== RIGHT : INCIDENT DETAILS ===== */
#right{grid-area:right;border-left:1px solid #0c0d10}
#right .panel-body{padding:0}
.idet{padding:14px}
.idet .st-id{font-family:'JetBrains Mono';font-size:12px;color:var(--ink-dim);letter-spacing:.14em}
.idet .st-name{font-family:'Noto Sans TC';font-size:22px;font-weight:900;color:var(--offwhite);margin:2px 0 12px;line-height:1.1}
.status-banner{display:flex;align-items:center;gap:10px;padding:10px 12px;margin-bottom:14px;border:1px solid;background:#1a1c22}
.status-banner .sb-dot{width:14px;height:14px;border-radius:50%;flex:0 0 auto}
.status-banner .sb-txt{flex:1}
.status-banner .sb-txt .t{font-family:'Oswald';font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:600}
.status-banner .sb-time{font-family:'JetBrains Mono';font-size:20px}
.sb-critical{border-color:var(--critical)}.sb-critical .t,.sb-critical .sb-time{color:var(--critical-2)}.sb-critical .sb-dot{background:var(--critical)}
.sb-warning{border-color:var(--warning)}.sb-warning .t,.sb-warning .sb-time{color:var(--warning)}.sb-warning .sb-dot{background:var(--warning)}
.sb-normal{border-color:var(--normal)}.sb-normal .t,.sb-normal .sb-time{color:var(--normal-2)}.sb-normal .sb-dot{background:var(--normal)}

.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--panel-line);border:1px solid var(--panel-line);margin-bottom:16px}
.stat-grid .cell{background:var(--panel-2);padding:11px 8px;text-align:center}
.stat-grid .cell .n{font-family:'Oswald';font-size:26px;font-weight:600;color:var(--offwhite);line-height:1}
.stat-grid .cell .k{font-size:9px;color:var(--ink-dim);letter-spacing:.1em;margin-top:4px;text-transform:uppercase}
.stat-grid .cell.alarm .n{color:var(--critical-2)}

.sec-h{font-family:'Oswald';font-size:11px;letter-spacing:.18em;color:var(--beige);text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:8px}
.sec-h::after{content:"";flex:1;height:1px;background:var(--panel-line)}
.spark{height:56px;background:#191c22;border:1px solid var(--panel-line);margin-bottom:16px;position:relative}
.spark canvas{display:block;width:100%;height:100%}
.spark .lbl{position:absolute;top:4px;left:6px;font-size:8px;color:var(--ink-dim);letter-spacing:.1em}

.btns{display:flex;flex-direction:column;gap:8px;margin-top:4px}
.btn{
  font-family:'Oswald';text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:600;
  padding:11px;border:1px solid var(--panel-line);background:#20242c;color:var(--ink);
  cursor:pointer;transition:all .15s;text-align:center;
}
.btn:hover{background:#2a2f38;color:var(--offwhite)}
.btn.primary{background:var(--critical);border-color:var(--critical);color:#fff}
.btn.primary:hover{background:var(--critical-2)}
.btn.ghost{background:transparent}
.btn:active{transform:translateY(1px)}

/* dispatch recommendation */
.reco{padding:14px;animation:slideIn .3s ease}
.reco .reco-h{font-family:'Oswald';font-size:11px;letter-spacing:.16em;color:var(--critical-2);text-transform:uppercase;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--critical)}
.reco .flow{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:16px}
.reco .flow .node{text-align:center;flex:1}
.reco .flow .node .n1{font-family:'JetBrains Mono';font-size:10px;color:var(--ink-dim)}
.reco .flow .node .n2{font-family:'Noto Sans TC';font-size:15px;font-weight:700;color:var(--offwhite)}
.reco .flow .arrow{color:var(--critical-2);font-size:22px;animation:pulseArrow 1.4s infinite}
.big-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--panel-line);border:1px solid var(--panel-line);margin-bottom:14px}
.big-stats .cell{background:var(--panel-2);padding:14px 6px;text-align:center}
.big-stats .cell .n{font-family:'Oswald';font-size:24px;color:var(--beige);font-weight:600;line-height:1}
.big-stats .cell .k{font-size:8px;color:var(--ink-dim);letter-spacing:.1em;margin-top:5px}
.traffic-row{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:#191c22;border:1px solid var(--panel-line);margin-bottom:14px;font-size:11px;letter-spacing:.1em}
.traffic-row .lab{color:var(--ink-dim)}
.traffic-row .val{font-family:'Oswald';letter-spacing:.14em;color:var(--normal-2);font-weight:600}

/* effective supply stat grid tweaks */
.stat-grid.supply3 .cell.good .n{color:var(--normal-2)}
/* anomaly banner in incident details */
.anom-banner{border:1px solid var(--critical);background:rgba(178,60,52,.10);padding:11px 12px;margin-bottom:14px}
.anom-banner.confirmed{border-color:var(--attention);background:rgba(194,166,60,.10)}
.anom-banner .ab-h{font-family:'Oswald';font-size:12px;letter-spacing:.12em;color:var(--critical-2);text-transform:uppercase;font-weight:600;margin-bottom:7px}
.anom-banner.confirmed .ab-h{color:var(--attention)}
.anom-banner .ab-txt{font-size:12.5px;color:var(--ink);line-height:1.6}
.anom-banner .ab-txt b{color:var(--offwhite)}
.anom-banner .ab-txt b.bad{color:var(--critical-2)}
.anom-banner .ab-txt b.good{color:var(--normal-2)}
.anom-banner .ab-note{font-size:10px;color:var(--ink-dim);letter-spacing:.06em;margin:8px 0 9px}
.btn.tiny{padding:8px 10px;font-size:11px;width:100%}
.btn.tiny.warn{background:var(--critical);border-color:var(--critical);color:#fff}
.btn.tiny.warn:hover{background:var(--critical-2)}

/* demand risk row */
.risk-row{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;margin-bottom:16px;border:1px solid var(--panel-line);background:#191c22;font-size:12px}
.risk-row .rk-l{color:var(--ink-dim);letter-spacing:.06em}
.risk-row .rk-v{font-family:'Oswald';font-weight:600;letter-spacing:.08em}
.risk-row.risk-high{border-color:var(--critical)}.risk-row.risk-high .rk-v{color:var(--critical-2)}
.risk-row.risk-med{border-color:var(--warning)}.risk-row.risk-med .rk-v{color:var(--warning)}
.risk-row.risk-low{border-color:var(--normal)}.risk-row.risk-low .rk-v{color:var(--normal-2)}

/* trend / imbalance / priority-reason (detail forecast block) */
.trend-row{display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:8px 12px;margin-bottom:8px;border:1px solid var(--panel-line);background:#191c22;font-size:11px}
.trend-row .tr-l{color:var(--ink-dim);letter-spacing:.06em;flex:0 0 auto}
.trend-row .tr-v{text-align:right;font-size:11px}
.trend-row .trend-FAST_FALLING{color:var(--critical-2)}
.trend-row .trend-FALLING{color:var(--warning)}
.trend-row .trend-RISING{color:var(--normal-2)}
.trend-row .trend-STABLE{color:var(--ink)}
.imb-row{padding:7px 12px;margin-bottom:8px;background:rgba(194,166,60,.10);border-left:3px solid var(--attention);color:var(--attention);font-size:11.5px;letter-spacing:.03em}
.prio-reason{font-size:11px;color:var(--ink-dim);margin-bottom:16px;letter-spacing:.02em;line-height:1.5}

/* supply columns in dispatch recommendation */
.supply-cols{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--panel-line);border:1px solid var(--panel-line);margin-bottom:8px}
.supply-cols .sc{background:var(--panel-2);padding:10px}
.supply-cols .sc-h{font-family:'Oswald';font-size:10px;letter-spacing:.12em;color:var(--beige);text-transform:uppercase;margin-bottom:7px;text-align:center;border-bottom:1px solid var(--panel-line);padding-bottom:5px}
.supply-cols .sc-row{display:flex;justify-content:space-between;align-items:baseline;font-size:11px;color:var(--ink-dim);padding:2px 0}
.supply-cols .sc-row b{font-family:'JetBrains Mono';font-size:13px;color:var(--offwhite);font-weight:500}
.supply-cols .sc-row b.good{color:var(--normal-2)}
.supply-cols .sc-row b.bad{color:var(--critical-2)}
.supply-cols .sc-row b.beige{color:var(--beige)}
.supply-note{font-size:11px;padding:7px 10px;margin-bottom:14px;letter-spacing:.03em}
.supply-note.warn{color:var(--critical-2);background:rgba(178,60,52,.08);border-left:3px solid var(--critical)}
.supply-note.ok{color:var(--normal-2);background:rgba(111,143,95,.08);border-left:3px solid var(--normal)}

/* ===== PHASE-2 DISPATCH RECOMMENDATION ===== */
.sec-h2{font-family:'Oswald';font-size:10px;letter-spacing:.16em;color:var(--beige);text-transform:uppercase;margin:14px 0 8px;display:flex;align-items:center;gap:8px}
.sec-h2::after{content:"";flex:1;height:1px;background:var(--panel-line)}
.pred-tag{font-size:11px;color:var(--ink-dim);letter-spacing:.03em;margin-bottom:6px}
.pred-tag b{font-family:'JetBrains Mono';font-weight:600}
.risk-high{color:var(--critical-2)!important}
.risk-med{color:var(--warning)!important}
.risk-low{color:var(--normal-2)!important}

/* source candidate comparison */
.src-cands{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--panel-line);border:1px solid var(--panel-line)}
.src-c{background:var(--panel-2);padding:9px 10px;position:relative}
.src-c.chosen{background:#20281f;box-shadow:inset 0 0 0 1px var(--normal)}
.src-c .src-badge{position:absolute;top:-1px;right:-1px;background:var(--normal);color:#fff;font-family:'Oswald';font-size:8px;letter-spacing:.1em;padding:1px 6px;font-weight:700}
.src-c .src-n{font-size:13px;font-weight:700;color:var(--offwhite);margin-bottom:5px}
.src-c .src-row{display:flex;justify-content:space-between;font-size:10.5px;color:var(--ink-dim);padding:1px 0}
.src-c .src-row b{font-family:'JetBrains Mono';font-size:12px;color:var(--offwhite);font-weight:500}
.src-c .src-row b.beige{color:var(--beige)}
.src-note{font-size:10.5px;color:var(--ink-dim);margin:7px 0 4px;line-height:1.5;border-left:2px solid var(--panel-line);padding-left:8px}

/* plan cards */
.plan-list{display:flex;flex-direction:column;gap:8px}
.plan-card{background:var(--panel-2);border:1px solid var(--panel-line);border-left:3px solid var(--panel-line);padding:9px 11px;cursor:pointer;transition:all .15s}
.plan-card:hover{background:#2a2f38}
.plan-card.sel{box-shadow:inset 0 0 0 1px var(--beige)}
.plan-card.rec{border-left-color:var(--normal)}
.plan-card.blocked{opacity:.62;border-left-color:var(--critical)}
.plan-card .plan-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}
.plan-card .plan-title{font-family:'Oswald';font-size:13px;letter-spacing:.08em;color:var(--offwhite);font-weight:600}
.plan-card .pt{font-family:'Oswald';font-size:9px;letter-spacing:.1em;padding:2px 7px;font-weight:700}
.plan-card .pt.rec{background:var(--normal);color:#fff}
.plan-card .pt.ok{background:#2a2f38;color:var(--ink);border:1px solid var(--panel-line)}
.plan-card .pt.blocked{background:#2c1a18;color:var(--critical-2);border:1px solid var(--critical)}
.plan-card .plan-rows{display:grid;grid-template-columns:1fr 1fr;gap:3px 12px}
.plan-card .pr{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-dim)}
.plan-card .pr b{font-family:'JetBrains Mono';font-size:13px;color:var(--offwhite);font-weight:500}
.plan-card .plan-warn{margin-top:7px;font-size:10.5px;color:var(--critical-2);letter-spacing:.02em}

/* why this plan */
.why{margin-top:14px;border:1px solid var(--panel-line);background:#191c22;padding:11px 12px}
.why .why-h{font-family:'Oswald';font-size:11px;letter-spacing:.16em;color:var(--beige);text-transform:uppercase;margin-bottom:8px}
.why .why-r{font-size:12px;color:var(--ink);line-height:1.7}
.why .why-r.bad{color:var(--critical-2)}
.why .why-concl{margin-top:8px;font-size:12.5px;color:var(--offwhite);border-top:1px solid var(--panel-line);padding-top:8px}
.why .why-concl b{color:var(--beige);font-family:'JetBrains Mono'}

/* before/after mini viz */
.ba{border:1px solid var(--panel-line);background:#191c22;padding:10px}
.ba-row{display:flex;align-items:center;gap:8px;padding:3px 0}
.ba-row .ba-k{font-size:10.5px;color:var(--ink-dim);width:52px;flex:0 0 auto}
.ba-row .ba-bar{flex:1;height:12px;background:#12151a;border:1px solid var(--panel-line);position:relative;overflow:hidden}
.ba-row .ba-bar i{position:absolute;left:0;top:0;bottom:0;transition:width .4s ease}
.ba-row .ba-v{font-family:'JetBrains Mono';font-size:11px;color:var(--offwhite);width:48px;text-align:right;flex:0 0 auto}
.ba-row .ba-risk{font-family:'JetBrains Mono';font-size:12px;width:42px;text-align:right;flex:0 0 auto;font-weight:600}
.risk-bg-high{background:var(--critical)}
.risk-bg-med{background:var(--warning)}
.risk-bg-low{background:var(--normal)}

/* ===== PHASE-3 INTERVENTION ===== */
.demo-pill{font-family:'Oswald';font-size:8px;letter-spacing:.12em;background:var(--attention);color:#16191f;padding:1px 6px;font-weight:700;margin-left:6px;vertical-align:middle}
.iv-decision{border:1px solid var(--panel-line);background:#191c22;padding:11px 12px;margin-bottom:16px;border-left:3px solid var(--panel-line)}
.iv-decision.iv-b-RELAY{border-left-color:var(--attention)}
.iv-decision.iv-b-FLEET{border-left-color:var(--critical)}
.iv-decision.iv-b-HYBRID{border-left-color:var(--warning)}
.iv-decision.iv-b-NONE{border-left-color:var(--normal)}
.iv-decision .ivd-head{display:flex;align-items:center;gap:8px;margin-bottom:9px}
.iv-decision .ivd-badge{font-family:'Oswald';font-size:9px;letter-spacing:.12em;font-weight:700;padding:2px 8px}
.iv-decision .ivd-title{font-family:'Noto Sans TC';font-size:14px;font-weight:700;color:var(--offwhite)}
.iv-decision .ivd-demo{margin-left:auto;font-family:'Oswald';font-size:8px;letter-spacing:.1em;color:var(--ink-dim);border:1px solid var(--panel-line);padding:1px 6px}
.iv-decision .ivd-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px 12px;margin-bottom:9px}
.iv-decision .ivd-grid > div{display:flex;justify-content:space-between;align-items:baseline;font-size:11px;color:var(--ink-dim);border-bottom:1px dotted var(--panel-line);padding-bottom:2px}
.iv-decision .ivd-grid .v{font-family:'JetBrains Mono';font-size:13px;color:var(--offwhite);font-weight:500}
.iv-decision .ivd-grid .v.good{color:var(--normal-2)}
.iv-decision .ivd-reason{font-size:12px;color:var(--ink);line-height:1.6}
.iv-decision .ivd-src{font-size:9px;color:var(--ink-dim);letter-spacing:.06em;margin-top:7px}
.iv-RELAY{background:var(--attention);color:#16191f}
.iv-FLEET{background:var(--critical);color:#fff}
.iv-HYBRID{background:var(--warning);color:#16191f}
.iv-NONE{background:var(--normal);color:#fff}
.btn.attn{background:var(--attention);border-color:var(--attention);color:#16191f}
.btn.attn:hover{background:#d4b64a}
.btn.warn2{background:var(--warning);border-color:var(--warning);color:#16191f}
.btn.warn2:hover{background:#d18a45}

/* relay recommendation card (right panel) */
.relay-card{border:1px solid var(--attention);background:rgba(194,166,60,.07);padding:13px;margin-bottom:12px}
.relay-card .rc-station{font-family:'Noto Sans TC';font-size:19px;font-weight:900;color:var(--offwhite);line-height:1.1}
.relay-card .rc-pred{font-size:12px;color:var(--ink-dim);margin:4px 0}
.relay-card .rc-pred.warn{color:var(--critical-2)}
.relay-card .rc-action{font-size:14px;color:var(--offwhite);margin:8px 0 10px}
.relay-card .rc-action b{color:var(--attention)}
.relay-card .relay-stats{display:grid;grid-template-columns:1fr;gap:4px;margin-bottom:9px}
.relay-card .relay-stats > div{display:flex;justify-content:space-between;align-items:baseline;font-size:11.5px;color:var(--ink-dim)}
.relay-card .relay-stats .v{font-family:'JetBrains Mono';font-size:14px;color:var(--offwhite);font-weight:500}
.relay-card .relay-stats .v.good{color:var(--normal-2)}
.relay-card .rc-note{font-size:10px;color:var(--ink-dim);letter-spacing:.02em}

/* intervention comparison table */
.iv-compare{border:1px solid var(--panel-line);background:#191c22;margin-bottom:8px}
.iv-compare .ivc-head,.iv-compare .ivc-row{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:1px}
.iv-compare .ivc-head{background:linear-gradient(180deg,#282d36,#20242b)}
.iv-compare .ivc-head span{font-family:'Oswald';font-size:9px;letter-spacing:.1em;color:var(--beige);padding:6px 8px;text-transform:uppercase}
.iv-compare .ivc-row{border-top:1px solid var(--panel-line)}
.iv-compare .ivc-row > span{font-size:11px;color:var(--ink-dim);padding:6px 8px}
.iv-compare .ivc-row > b{font-family:'JetBrains Mono';font-size:12px;color:var(--offwhite);padding:6px 8px;text-align:center}
.iv-compare .ivc-row > b.good{color:var(--normal-2)}

/* ===== BOTTOM ===== */
#bottom{grid-area:bottom;display:grid;grid-template-columns:1.35fr 1fr;gap:1px;background:#0c0d10;border-top:1px solid #0c0d10}
#duty .panel-body{display:flex;gap:1px;padding:0;background:var(--panel-line);overflow-x:auto;overflow-y:hidden}
.crew{background:var(--panel);min-width:118px;flex:1;padding:10px;display:flex;flex-direction:column;align-items:center;gap:6px;border-bottom:2px solid transparent}
.crew.on{border-bottom-color:var(--normal)}
.crew.break{border-bottom-color:var(--attention)}
.crew.off{border-bottom-color:var(--warm-gray);opacity:.6}
.crew .num{font-family:'JetBrains Mono';font-size:9px;color:var(--ink-dim);align-self:flex-start}
.crew .portrait{width:44px;height:44px;border:1px solid var(--panel-line);background:#14161b}
.crew .cname{font-size:13px;font-weight:700;color:var(--offwhite)}
.crew .role{font-family:'Oswald';font-size:8.5px;letter-spacing:.14em;color:var(--beige)}
.crew .cstat{font-size:9px;letter-spacing:.08em;display:flex;align-items:center;gap:4px}
.crew .cstat i{width:6px;height:6px;border-radius:50%;display:inline-block}
.cstat.on i{background:var(--normal)}.cstat.on{color:var(--normal-2)}
.cstat.break i{background:var(--attention)}.cstat.break{color:var(--attention)}
.cstat.off i{background:var(--warm-gray)}.cstat.off{color:var(--warm-gray)}

/* active dispatch */
.mission{padding:9px 12px;border-bottom:1px solid var(--panel-line);display:flex;align-items:center;gap:10px}
.mission .mid{font-family:'JetBrains Mono';font-size:11px;color:var(--beige);min-width:46px}
.mission .mroute{flex:1;font-size:13px;color:var(--offwhite);font-weight:500}
.mission .mroute small{color:var(--ink-dim);font-size:10px;display:block;font-weight:400;letter-spacing:.06em}
.mission .mstat{font-family:'Oswald';font-size:9px;letter-spacing:.12em;padding:2px 7px;font-weight:600;white-space:nowrap}
.mstat.WAITING{background:#2a2c33;color:var(--attention);border:1px solid var(--attention)}
.mstat.PROGRESS{background:#2a2419;color:var(--warning);border:1px solid var(--warning)}
.mstat.UNASSIGNED{background:#2c1a18;color:var(--critical-2);border:1px solid var(--critical);animation:flick 1.6s infinite}
.mstat.DONE{background:#1e281a;color:var(--normal-2);border:1px solid var(--normal)}
.mstat.DISPATCHING{background:#2a2c33;color:var(--attention);border:1px solid var(--attention);animation:flick 1.6s infinite}
.mstat.TRANSIT{background:#2a2419;color:var(--warning);border:1px solid var(--warning)}
.mstat.ARRIVED{background:#1f2833;color:#8fb3c9;border:1px solid #557089}
.mstat.PARTIAL{background:#2a2419;color:var(--warning);border:1px solid var(--warning)}

/* toast */
#toast{position:fixed;bottom:180px;left:50%;transform:translateX(-50%);background:#20242c;border:1px solid var(--normal);border-left:4px solid var(--normal);padding:12px 20px;color:var(--offwhite);font-family:'Oswald';letter-spacing:.1em;font-size:13px;opacity:0;pointer-events:none;transition:opacity .3s,transform .3s;z-index:99;text-transform:uppercase}
#toast.show{opacity:1;transform:translateX(-50%) translateY(-6px)}

/* animations */
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideIn{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:none}}
@keyframes pulseArrow{0%,100%{opacity:.4}50%{opacity:1}}
@keyframes flick{0%,100%{opacity:1}48%{opacity:1}50%{opacity:.35}52%{opacity:1}}
@keyframes countPop{0%{transform:scale(1)}40%{transform:scale(1.35);color:var(--critical-2)}100%{transform:scale(1)}}
.count-pop{animation:countPop .5s ease}

/* ===== VIEW TOGGLE + DEMO (top bar) ===== */
.view-toggle{display:flex;border:1px solid var(--panel-line);background:#14161b;margin-left:4px}
.view-toggle button{
  font-family:'Oswald';text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:600;
  padding:7px 14px;background:transparent;color:var(--ink-dim);border:none;cursor:pointer;transition:all .15s;
}
.view-toggle button.active{background:var(--beige);color:#16191f}
.view-toggle button:not(.active):hover{color:var(--offwhite)}
.demo-btn{
  font-family:'Oswald';text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:600;
  padding:7px 12px;background:transparent;color:var(--attention);border:1px solid var(--attention);cursor:pointer;
  margin-left:8px;transition:all .15s;
}
.demo-btn:hover{background:var(--attention);color:#16191f}
.demo-btn:disabled{opacity:.4;cursor:default}
.demo-btn.running{background:var(--attention);color:#16191f}

/* ===== PUBLIC VIEW ===== */
#public{
  position:fixed;inset:0;z-index:40;display:none;flex-direction:column;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.10) 3px, rgba(0,0,0,0.10) 4px),
    radial-gradient(ellipse at 50% 0%, #23272f 0%, var(--navy) 62%, #101216 100%);
}
body.public-mode #public{display:flex}
#public .pub-top{
  display:flex;align-items:center;gap:16px;padding:0 20px;height:58px;flex:0 0 auto;
  background:linear-gradient(180deg,#20242c,#191c22);border-bottom:2px solid var(--beige);
}
#public .pub-brand{display:flex;align-items:center;gap:11px}
#public .pub-brand .mark{width:30px;height:30px;background:var(--normal);display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Oswald';font-weight:700;font-size:16px;border-radius:2px}
#public .pub-brand h1{font-family:'Oswald';font-size:19px;letter-spacing:.14em;color:var(--offwhite);text-transform:uppercase;font-weight:600}
#public .pub-brand .sub{font-size:11px;color:var(--ink-dim);letter-spacing:.08em}
#public .pub-spacer{flex:1}
#public .pub-clock{font-family:'JetBrains Mono';font-size:15px;color:var(--beige)}

/* search bar */
#public .pub-search{position:relative;width:340px;max-width:42vw}
#public .pub-search input{
  width:100%;padding:10px 14px 10px 38px;background:#14161b;border:1px solid var(--panel-line);
  color:var(--offwhite);font-family:'Noto Sans TC';font-size:14px;letter-spacing:.03em;outline:none;
}
#public .pub-search input:focus{border-color:var(--beige)}
#public .pub-search .mag{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ink-dim);font-size:15px;pointer-events:none}
#public .pub-search .results{
  position:absolute;top:100%;left:0;right:0;background:#1c2027;border:1px solid var(--panel-line);border-top:none;
  z-index:5;max-height:280px;overflow-y:auto;display:none;
}
#public .pub-search .results.on{display:block}
#public .pub-search .res{padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--panel-line);display:flex;align-items:center;gap:10px}
#public .pub-search .res:hover{background:var(--panel-2)}
#public .pub-search .res .rdot{width:10px;height:10px;border-radius:50%;flex:0 0 auto}
#public .pub-search .res .rn{font-size:14px;color:var(--offwhite);font-weight:500;flex:1}
#public .pub-search .res .rd{font-size:11px;color:var(--ink-dim)}
#public .pub-search .res .rb{font-family:'JetBrains Mono';font-size:12px;color:var(--beige)}
#public .pub-search .nores{padding:14px;color:var(--ink-dim);font-size:13px;text-align:center}

/* public body layout */
#public .pub-body{
  flex:1;display:grid;
  grid-template-columns: 1fr 380px;
  grid-template-rows: 1fr 210px;
  grid-template-areas:"pmap pinfo" "pnearby pinfo";
  gap:1px;background:#0c0d10;min-height:0;
}
#public .pub-map{grid-area:pmap;position:relative;background:#12151a;overflow:hidden}
#public .pub-info{grid-area:pinfo;background:var(--panel);overflow-y:auto;border-left:1px solid #0c0d10}
#public .pub-nearby{grid-area:pnearby;background:var(--panel);overflow-y:auto;border-top:1px solid #0c0d10}

/* map hint overlay for public */
#pub-map-note{position:absolute;top:12px;left:14px;pointer-events:none}
#pub-map-note .t1{font-family:'Oswald';font-size:13px;letter-spacing:.2em;color:var(--offwhite);text-transform:uppercase}
#pub-map-note .t2{font-size:11px;color:var(--ink-dim);margin-top:2px}
#pub-legend{position:absolute;bottom:12px;left:14px;display:flex;gap:12px;background:rgba(18,21,26,.8);border:1px solid var(--panel-line);padding:7px 12px}
#pub-legend .lg{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--ink)}
#pub-legend .lg i{width:10px;height:10px;border-radius:50%}
#pub-nav-readout{position:absolute;bottom:12px;right:14px;background:rgba(18,21,26,.92);border:1px solid var(--normal);padding:10px 14px;display:none}
#pub-nav-readout.on{display:block;animation:fadeIn .3s ease}
#pub-nav-readout .h{font-family:'Oswald';font-size:10px;letter-spacing:.14em;color:var(--normal-2);text-transform:uppercase}
#pub-nav-readout .n{font-size:13px;color:var(--offwhite);font-weight:700;margin:4px 0}
#pub-nav-readout .s{display:flex;gap:18px}
#pub-nav-readout .s div{text-align:center}
#pub-nav-readout .s .v{font-family:'JetBrains Mono';font-size:16px;color:var(--beige)}
#pub-nav-readout .s .k{font-size:8px;color:var(--ink-dim);letter-spacing:.1em}

/* public panel headers */
.pub-h{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--panel-line);background:linear-gradient(180deg,#282d36,#20242b);position:sticky;top:0;z-index:2}
.pub-h h2{font-family:'Oswald';font-size:14px;letter-spacing:.14em;text-transform:uppercase;color:var(--offwhite);font-weight:600}
.pub-h .tag{margin-left:auto;font-size:10px;color:var(--ink-dim);letter-spacing:.1em}

/* station info (public) */
.pinfo-inner{padding:18px 16px}
.pinfo-inner .empty-hint{color:var(--ink-dim);text-align:center;padding-top:40px;font-size:14px;line-height:1.7}
.pub-st-name{font-family:'Noto Sans TC';font-size:26px;font-weight:900;color:var(--offwhite);line-height:1.15}
.pub-st-dist{font-size:12px;color:var(--ink-dim);letter-spacing:.06em;margin-top:2px}
.pub-status-chip{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;margin:16px 0;font-size:15px;font-weight:700;border-radius:2px}
.chip-green{background:rgba(111,143,95,.15);color:var(--normal-2);border:1px solid var(--normal)}
.chip-yellow{background:rgba(194,166,60,.13);color:var(--attention);border:1px solid var(--attention)}
.chip-red{background:rgba(178,60,52,.15);color:var(--critical-2);border:1px solid var(--critical)}
.chip-park{background:rgba(143,135,120,.15);color:var(--beige);border:1px solid var(--muted-beige)}
.pub-bignums{display:flex;gap:1px;background:var(--panel-line);border:1px solid var(--panel-line);margin-bottom:16px}
.pub-bignums .cell{flex:1;background:var(--panel-2);padding:16px 8px;text-align:center}
.pub-bignums .cell .ico{font-size:16px}
.pub-bignums .cell .n{font-family:'Oswald';font-size:34px;font-weight:700;color:var(--offwhite);line-height:1;margin-top:4px}
.pub-bignums .cell .k{font-size:11px;color:var(--ink-dim);margin-top:5px}
.pub-bignums .cell.zero .n{color:var(--critical-2)}
.pub-msg{padding:12px 14px;background:#191c22;border-left:3px solid var(--beige);font-size:14px;color:var(--ink);line-height:1.6;margin-bottom:16px}
.pub-msg.alert{border-left-color:var(--critical)}

/* community relay */
.relay{border:1px dashed var(--attention);background:rgba(194,166,60,.06);padding:14px;margin-bottom:16px}
.relay .rh{display:flex;align-items:center;gap:8px;font-family:'Oswald';font-size:12px;letter-spacing:.14em;color:var(--attention);text-transform:uppercase;margin-bottom:8px}
.relay p{font-size:13px;color:var(--ink);line-height:1.65;margin-bottom:10px}
.relay .rbtn{font-family:'Oswald';font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--attention);background:transparent;border:1px solid var(--attention);padding:7px 12px;cursor:pointer}
.relay .rbtn:hover{background:var(--attention);color:#16191f}
.relay .relay-demo{margin-left:auto;font-size:8px;background:var(--attention);color:#16191f;padding:1px 6px;letter-spacing:.08em}
.relay .relay-pub-pred{font-size:12px;color:var(--critical-2);margin-bottom:4px}
.relay .relay-pub-action{font-size:15px;color:var(--offwhite);margin-bottom:9px}
.relay .relay-pub-action b{color:var(--attention)}
.relay .relay-pub-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:9px}
.relay .relay-pub-stats > div{display:flex;flex-direction:column;background:#14161b;border:1px solid var(--panel-line);padding:6px 8px}
.relay .relay-pub-stats span{font-size:9px;color:var(--ink-dim);letter-spacing:.04em}
.relay .relay-pub-stats b{font-family:'Oswald';font-size:18px;color:var(--attention);font-weight:600}
.relay .relay-pub-note{font-size:11px;color:var(--ink-dim);line-height:1.6;margin-bottom:10px}

/* nearby recommendation cards */
.nearby-wrap{padding:14px 16px;display:flex;gap:12px;flex-wrap:wrap}
.nearby-empty{padding:24px 16px;color:var(--ink-dim);font-size:13px}
.rec-card{
  background:var(--panel-2);border:1px solid var(--panel-line);border-top:3px solid var(--normal);
  padding:12px 14px;width:210px;flex:0 0 auto;position:relative;
}
.rec-card.best{border-top-color:var(--beige);box-shadow:0 0 0 1px var(--beige)}
.rec-card.ai{border-top-color:var(--attention)}
