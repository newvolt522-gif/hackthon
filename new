<script>
/* =====================================================================
   DATA MODEL  — everything driven from data, nothing hardcoded in markup
   Coordinates are isometric grid coords (gx, gy) on the city model.
   ===================================================================== */
/* =====================================================================
   ADDON — 新增功能疊加層（不改動地圖與既有函式）
   1) 三指標嚴格風險：即時訊號 + P10/P90 分位數 + 歷史模型機率（嚴格 AND）
   2) 站點異常 FSM：watch(30m)->suspected(60m)->notified(90m) 並主動通知
   3) 安全鄰站調度半徑
   4) 道路事件 ETA（不改 drawRoute）
   5) 派遣任務值班員指派
   全部為 DEMO 估計；模型尚未訓練，明確標示 DEMO MODEL。
   ===================================================================== */
var ADDON = (function(){
  const CFG = {
    modelProbThreshold: 0.70,
    neighborRadiusKm: 3.0,
    anomaly: { watch: 30, suspected: 60, notified: 90 },
  };
  function quantiles(mid, confidence){
    const spread = (1 - Math.max(0.5, Math.min(0.95, confidence))) * 0.9 + 0.12;
    return { p10: Math.max(0, mid - spread*mid), p50: mid, p90: Math.min(1, mid + spread*(1-mid)) };
  }
  function historicalProbability(s, direction){
    const prof = demandService.getDemandProfile(s);
    const trendW = prof.trend==='FAST_FALLING'?0.9 : prof.trend==='FALLING'?0.7 : prof.trend==='RISING'?0.2 : 0.4;
    const durW = Math.min(1, imbalanceDuration(s)/90);
    const supplyW = direction==='dock'
      ? 1 - Math.min(1, (s.empty ?? 0)/Math.max(6, s.cap*0.25))
      : 1 - Math.min(1, effectiveAvail(s)/Math.max(6, s.cap*0.25));
    return Math.max(0, Math.min(1, Math.round((trendW*0.4 + durW*0.25 + supplyW*0.35)*100)/100));
  }
  function strictDirection(s, direction){
    const pred = getPrediction(s);
    const cap = Math.max(1, s.cap||1);
    const nowSupply = direction==='dock' ? (s.empty ?? 0) : effectiveAvail(s);
    const reserve = safeReserve(s);
    const rtRisk = nowSupply <= reserve;
    const mid = direction==='dock' ? pred.predictedEmptyDockRatio30 : pred.predictedAvailableRatio30;
    const q = quantiles(mid, pred.confidence);
    const p10Level = q.p10 * cap;
    const quantRisk = p10Level <= reserve;
    const histProb = historicalProbability(s, direction);
    const histRisk = histProb >= CFG.modelProbThreshold;
    const signals = [
      { name: (predictionService.isMock()?'即時訊號 (DEMO)':'即時共享單車 API'), pass: rtRisk,
        detail: '現況 '+nowSupply+' vs 安全量 '+reserve },
      { name: '30分鐘 P10 分位數', pass: quantRisk,
        detail: 'P10≈'+p10Level.toFixed(1)+' / P50≈'+(q.p50*cap).toFixed(1)+' / P90≈'+(q.p90*cap).toFixed(1) },
      { name: '歷史模型機率 (DEMO MODEL)', pass: histRisk,
        detail: (histProb*100).toFixed(0)+'% vs 門檻 '+(CFG.modelProbThreshold*100).toFixed(0)+'%' },
    ];
    const passed = signals.filter(x=>x.pass).length;
    return { direction, signals, passedCount: passed, formalAlert: passed===3, quantiles:q, histProb };
  }
  function strictRisk(s){
    const borrow = strictDirection(s, 'borrow');
    const dock = strictDirection(s, 'dock');
    return { borrow, dock, formalAny: borrow.formalAlert || dock.formalAlert };
  }
  function anomalyState(s){
    const faults = s.suspectedFault ?? 0;
    const idle = s.longestIdleMin ?? 0;
    const highDemand = (s.importance ?? 1) >= 1.1 || s.cap >= 26;
    if(faults <= 0 || !highDemand){
      return { state:'normal', idle, faults, highDemand,
        reason: faults<=0 ? '無疑似長時間停留車輛。' : '非高流量站，暫不累積型態異常。' };
    }
    let state='normal';
    if(idle >= CFG.anomaly.notified) state='notified';
    else if(idle >= CFG.anomaly.suspected) state='suspected';
    else if(idle >= CFG.anomaly.watch) state='watch';
    if(s.faultConfirmed) state='confirmed';
    const labelMap = { watch:'可疑站點（觀察中）', suspected:'高度可疑（待複查）', notified:'已通知調度人員', confirmed:'已確認異常', normal:'正常' };
    return { state, idle, faults, highDemand, label: labelMap[state],
      reason: '高流量站卻有 '+faults+' 台車長時間停留（最長 '+fmtIdle(idle)+'）。' };
  }
  function isNeighbor(a, b){
    try{ return dispatchService.km(a,b) <= CFG.neighborRadiusKm; }catch(e){ return true; }
  }
  function roadDelayMin(a, b){
    if(!a||!b) return 0;
    const dist = dispatchService.gridDist(a,b);
    let delay = 0;
    const crossesRiver = (typeof RIVER_CELLS!=='undefined') &&
      [...RIVER_CELLS].some(function(k){ var p=k.split(',').map(Number);
        return Math.abs(((a.gx+b.gx)/2)-p[0])<1 && Math.abs(((a.gy+b.gy)/2)-p[1])<1; });
    if(crossesRiver) delay += 7;
    if(dist >= 6) delay += 3;
    return delay;
  }
  function assignCrew(mission){
    const busy = new Set(DATA.dispatches
      .filter(function(d){ return d.assignedCrewId && d.status!=='DONE' && d.status!=='PARTIAL'; })
      .map(function(d){ return d.assignedCrewId; }));
    const pool = (DATA.crew||[]).filter(function(c){ return c.status==='on' && !busy.has(c.num); });
    const rank = function(c){ return c.role==='DRIVER'?0 : c.role==='FIELD OPS'?1 : c.role==='DISPATCH'?2 : 3; };
    pool.sort(function(a,b){ return rank(a)-rank(b); });
    const chosen = pool[0];
    if(chosen){ mission.assignedCrewId=chosen.num; mission.assignedCrewName=chosen.name; }
    else { mission.assignedCrewName='待指派'; }
    return chosen||null;
  }
  function enrichStation(s){
    s.strictRisk = strictRisk(s);
    s.anomalyFsm = anomalyState(s);
    if(s.anomalyFsm.state==='notified' && !s._notifiedOnce){
      s._notifiedOnce = true;
      setTimeout(function(){ toast('🚨 主動通知調度人員 · '+s.name+' 疑似異常已持續 '+fmtIdle(s.anomalyFsm.idle)+'，建議派員複查'); }, 300);
    }
  }
  function signalRow(sig){
    const color = sig.pass ? 'var(--critical-2)' : 'var(--normal-2)';
    const mark = sig.pass ? '✕ 有風險' : '✓ 無風險';
    return '<div class="trend-row"><span class="tr-l">'+sig.name+'</span>'+
      '<span class="tr-v" style="color:'+color+'">'+mark+' · <span style="color:var(--ink-dim)">'+sig.detail+'</span></span></div>';
  }
  function directionStrictHtml(title, d){
    const badge = d.formalAlert
      ? '<span style="color:var(--critical-2);font-weight:700">正式風險 3/3</span>'
      : '<span style="color:var(--ink-dim)">未成立（'+d.passedCount+'/3）</span>';
    return '<div style="margin-bottom:8px"><div class="pred-tag"><b>'+title+'</b> · '+badge+'</div>'+
      d.signals.map(signalRow).join('')+'</div>';
  }
  function strictRiskBlock(s){
    const r = s.strictRisk || strictRisk(s);
    return '<div class="sec-h">三指標嚴格風險 · STRICT 3/3 <span class="demo-pill">DEMO</span></div>'+
      '<div class="prio-reason" style="margin-bottom:10px">即時訊號、P10/P90 分位數、歷史模型機率三者皆判定有風險，才成立正式風險（嚴格 AND）。</div>'+
      directionStrictHtml('借車風險（無車可借）', r.borrow)+
      directionStrictHtml('還車風險（無位可還）', r.dock);
  }
  function anomalyFsmBlock(s){
    const a = s.anomalyFsm || anomalyState(s);
    if(a.state==='normal') return '';
    const stages = ['watch','suspected','notified'];
    const activeIdx = a.state==='confirmed' ? 3 : stages.indexOf(a.state);
    const nameMap = {watch:'可疑 30m',suspected:'待複查 60m',notified:'通知 90m'};
    const dots = stages.map(function(stg,i){
      const on = i<=activeIdx;
      const col = on ? (stg==='notified'?'var(--critical-2)':stg==='suspected'?'var(--warning)':'var(--attention)') : 'var(--panel-line)';
      return '<div style="flex:1;text-align:center">'+
        '<div style="width:10px;height:10px;border-radius:50%;background:'+col+';margin:0 auto 4px"></div>'+
        '<div style="font-size:9px;color:'+(on?'var(--offwhite)':'var(--ink-dim)')+';letter-spacing:.04em">'+nameMap[stg]+'</div></div>';
    }).join('');
    return '<div class="sec-h">站點異常偵測 · ANOMALY FSM <span class="demo-pill">DEMO</span></div>'+
      '<div class="anom-banner '+((a.state==='notified'||a.state==='confirmed')?'':'confirmed')+'">'+
      '<div class="ab-h">狀態：'+(a.label||a.state)+'</div>'+
      '<div style="display:flex;gap:6px;margin:8px 0 6px">'+dots+'</div>'+
      '<div class="ab-txt">'+a.reason+'<br>依滯留時間逐步升級：30 分鐘標示可疑、60 分鐘待複查、90 分鐘主動通知調度人員。</div>'+
      '<div class="ab-note">此為站點層級供給型態偵測，非辨識特定故障車。</div></div>';
  }
  return {
    CFG: CFG, enrichStation: enrichStation, strictRisk: strictRisk, anomalyState: anomalyState,
    strictRiskBlock: strictRiskBlock, anomalyFsmBlock: anomalyFsmBlock,
    isNeighbor: isNeighbor, roadDelayMin: roadDelayMin, assignCrew: assignCrew
  };
})();

const DATA = {
  stations: [
    // NOTE: `avail` = API 帳面可借車 (kept intact for future real-API mapping).
