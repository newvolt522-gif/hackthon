/* ---- staged dispatch lifecycle ----
   Accept does NOT teleport bikes. Mission advances:
   DISPATCHING → IN TRANSIT → ARRIVED → RESOLVED / PARTIALLY RESOLVED
   Bikes are only applied to the target on ARRIVED; risk is recomputed then. */
const LIFECYCLE=['DISPATCHING','TRANSIT','ARRIVED','DONE'];
let dispatchSeq=5;

function acceptDispatch(){
  if(!ROUTE)return;
  const src=ROUTE.from, tgt=ROUTE.to, bikes=ROUTE.bikes;
  const riskBefore=getStationRisk30(tgt);
  const newId='D-'+String(dispatchSeq++).padStart(3,'0');
  const mission={
    id:newId, route:`${short(src.name)} → ${short(tgt.name)}`, bikes,
    status:'DISPATCHING', sourceId:src.id, targetId:tgt.id, riskBefore,
    _staged:true
  };
  if(typeof ADDON!=='undefined'){
    try{ ADDON.assignCrew(mission); }catch(e){}
  }
  DATA.dispatches.unshift(mission);

  // reserve bikes from source immediately (they leave the source now)
  src.reportedAvail=Math.max(0,(src.reportedAvail ?? src.avail)-bikes);
  src.avail=Math.max(0, src.avail-bikes);

  toast(`DISPATCH ${newId} · 方案 +${bikes} · 已指派，車輛整備中 (DISPATCHING)`);
  STATE.calls=buildCalls();
  backToDetail();
  renderCalls(); renderDispatch(); renderRight(); updateTop(true);
  if(STATE.view==='public') pubRender();

  advanceMission(mission);
}

function advanceMission(m){
  // DISPATCHING -> TRANSIT
  m._t1=setTimeout(()=>{
    m.status='TRANSIT';
    renderDispatch();
    toast(`DISPATCH ${m.id} · 車輛運送中 (IN TRANSIT)`);
    // TRANSIT -> ARRIVED
    m._t2=setTimeout(()=>{
      m.status='ARRIVED';
      // apply bikes to target now
      const t=st(m.targetId);
      if(t){
        t.reportedAvail=(t.reportedAvail ?? t.avail)+m.bikes;
        t.avail=(t.avail||0)+m.bikes;
        t.empty=Math.max(0,t.empty-m.bikes);
        t.imbalanceDuration=0;
      }
      renderDispatch();
      toast(`DISPATCH ${m.id} · 車輛已抵達 (ARRIVED)`);
      // ARRIVED -> resolve (recompute risk)
      m._t3=setTimeout(()=>{
        resolveMission(m);
      }, 2200);
    }, 4200);
  }, 4200);
}

function resolveMission(m){
  const t=st(m.targetId);
  const riskAfter = t ? getStationRisk30(t) : 0;
  m.riskAfter=riskAfter;
  const stillHigh = riskAfter>=50;
  if(t){
    if(stillHigh){
      t.status='warning'; t.issue='改善但仍需追蹤';
    } else {
      t.status='normal'; t.issue='已補車完成'; t.waitMin=0;
    }
  }
  m.status = stillHigh ? 'PARTIAL' : 'DONE';
  STATE.calls=buildCalls();
  renderCalls(); renderDispatch(); updateTop(true);
  if(STATE.selectedId===m.targetId && STATE.detailMode==='detail') renderRight();
  if(STATE.view==='public') pubRender();
  toast(stillHigh
    ? `DISPATCH ${m.id} · 改善但仍需追蹤 · 風險 ${m.riskBefore}% → ${riskAfter}% (PARTIALLY RESOLVED)`
    : `DISPATCH ${m.id} · 已解除 · 風險 ${m.riskBefore}% → ${riskAfter}% (RESOLVED)`);
}

function lifecycleLabel(st){
  return st==='DISPATCHING'?'DISPATCHING'
       : st==='TRANSIT'?'IN TRANSIT'
       : st==='ARRIVED'?'ARRIVED'
       : st==='PARTIAL'?'PARTIAL'
       : st==='DONE'?'RESOLVED'
       : st;
}

/* ---- confirm suspected anomaly (Demo state only) ----
   確認後：疑似 → 已確認，並自帳面供給排除。avail 保留為 API 帳面值，
