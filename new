    {id:'0055', name:'新莊幸福站',   gx:2, gy:4,  status:'warning',  issue:'車輛偏少',     avail:5,  reportedAvail:5,  suspectedFault:1, longestIdleMin:74,  empty:19, cap:26, waitMin:14, prio:'MED',  district:'新莊區', faultConfirmed:false, delta30:-2, delta60:-4, deltaEmpty30:2,  deltaEmpty60:4,  imbalanceDuration:33, importance:1.0},
