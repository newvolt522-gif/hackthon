  PORIGIN.y=PH/2-(GRID.rows*TILE.h)/2+20;
}
function piso(gx,gy){ return { x:PORIGIN.x+(gx-gy)*TILE.w/2, y:PORIGIN.y+(gx+gy)*TILE.h/2 }; }

function pubDrawGround(){
  for(let gy=0;gy<GRID.rows;gy++)for(let gx=0;gx<GRID.cols;gx++){
    const t=cellType(gx,gy);
    let fill = t==='river'?'#1e2b33': t==='road'?'#20242b': ((gx+gy)%2?'#181c22':'#1b1f26');
    const p=piso(gx,gy);
    pctx.beginPath();
    pctx.moveTo(p.x,p.y);pctx.lineTo(p.x+TILE.w/2,p.y+TILE.h/2);pctx.lineTo(p.x,p.y+TILE.h);pctx.lineTo(p.x-TILE.w/2,p.y+TILE.h/2);pctx.closePath();
    pctx.fillStyle=fill;pctx.fill();pctx.strokeStyle='rgba(0,0,0,.22)';pctx.lineWidth=1;pctx.stroke();
  }
}
function pubDrawBuilding(gx,gy){
  const p=piso(gx,gy);const seed=rnd(gx,gy),seed2=rnd(gy,gx);
  const h=12+seed*34, inset=10+seed2*7, w=TILE.w/2-inset, d=TILE.h/2-inset*0.5;
  const bx=p.x, byBase=p.y+TILE.h/2, topOff=h;
  const bTop={x:bx,y:byBase-d-topOff},bRight={x:bx+w,y:byBase-topOff},bBot={x:bx,y:byBase+d-topOff},bLeft={x:bx-w,y:byBase-topOff};
  const gRight={x:bx+w,y:byBase},gBot={x:bx,y:byBase+d},gLeft={x:bx-w,y:byBase};
  pctx.beginPath();pctx.moveTo(bLeft.x,bLeft.y);pctx.lineTo(bBot.x,bBot.y);pctx.lineTo(gBot.x,gBot.y);pctx.lineTo(gLeft.x,gLeft.y);pctx.closePath();pctx.fillStyle='#232830';pctx.fill();
  pctx.beginPath();pctx.moveTo(bBot.x,bBot.y);pctx.lineTo(bRight.x,bRight.y);pctx.lineTo(gRight.x,gRight.y);pctx.lineTo(gBot.x,gBot.y);pctx.closePath();pctx.fillStyle='#1b1f26';pctx.fill();
  pctx.beginPath();pctx.moveTo(bTop.x,bTop.y);pctx.lineTo(bRight.x,bRight.y);pctx.lineTo(bBot.x,bBot.y);pctx.lineTo(bLeft.x,bLeft.y);pctx.closePath();pctx.fillStyle='#2e343d';pctx.fill();
  pctx.strokeStyle='rgba(0,0,0,.3)';pctx.lineWidth=1;pctx.stroke();
}
function pubDrawBuildings(){
  for(let gy=0;gy<GRID.rows;gy++)for(let gx=0;gx<GRID.cols;gx++){
    if(cellType(gx,gy)==='block'){
      if(DATA.stations.some(s=>s.gx===gx&&s.gy===gy))continue;
      if(rnd(gx*3.1,gy*1.7)>0.32) pubDrawBuilding(gx,gy);
    }
  }
}
function pubStatusColor(s){
  const ps=publicStatus(s);
  return ps.level==='green'?'#6f8f5f':ps.level==='yellow'?'#c2a63c':ps.level==='park'?'#b7ad99':'#b23c34';
}
function pubDrawMarker(s){
  const p=piso(s.gx,s.gy);const baseY=p.y+TILE.h/2;
  const selected=STATE.pubSelectedId===s.id;
  const ps=publicStatus(s);
  const col=pubStatusColor(s);
  const big = selected || ps.level==='red';
  const r=big?12:8;
  pctx.fillStyle='rgba(0,0,0,.35)';pctx.beginPath();pctx.ellipse(p.x,baseY,10,4,0,0,Math.PI*2);pctx.fill();
  if(selected || ps.level==='red'){
    const pr=r+6+Math.sin(pulse)*5+6;
    pctx.strokeStyle=selected?'rgba(183,173,153,'+(0.5-0.4*Math.abs(Math.sin(pulse)))+')':'rgba(178,60,52,'+(0.5-0.4*Math.abs(Math.sin(pulse)))+')';
    pctx.lineWidth=2;pctx.beginPath();pctx.arc(p.x,baseY-26,pr,0,Math.PI*2);pctx.stroke();
  }
  const pinY=baseY-26;
  pctx.strokeStyle='rgba(0,0,0,.5)';pctx.lineWidth=2;pctx.beginPath();pctx.moveTo(p.x,baseY);pctx.lineTo(p.x,pinY);pctx.stroke();
  pctx.beginPath();pctx.arc(p.x,pinY,r,0,Math.PI*2);pctx.fillStyle=selected?'#d8cdb4':col;pctx.fill();
  pctx.strokeStyle=selected?'#fff':'rgba(0,0,0,.6)';pctx.lineWidth=selected?2:1.5;pctx.stroke();
  // icon: bike count or park symbol
  pctx.fillStyle=(ps.level==='park'||selected)?'#16191f':'#fff';
  pctx.font='bold 10px Oswald';pctx.textAlign='center';pctx.textBaseline='middle';
  pctx.fillText(ps.level==='park'?'P':String(ps.bikes),p.x,pinY);
  // relay indicator (public sees the community-relay nudge, not internal fleet/risk)
  const iv=s.intervention||decideIntervention(s);
  const relayHere = s.relayActive || iv.type==='RELAY' || iv.type==='HYBRID';
  if(relayHere){
    pctx.fillStyle='#c2a63c';pctx.strokeStyle='#16191f';pctx.lineWidth=1.5;
    pctx.beginPath();pctx.arc(p.x+r-1,pinY-r+2,6,0,Math.PI*2);pctx.fill();pctx.stroke();
    pctx.fillStyle='#16191f';pctx.font='bold 8px Oswald';pctx.textBaseline='middle';
    pctx.fillText('♻',p.x+r-1,pinY-r+2);
  }
  // label
  pctx.font='11px "Noto Sans TC"';pctx.textAlign='center';pctx.textBaseline='top';
  const relayTag = relayHere ? (s.relayActiveDir==='BORROW'||iv.direction==='BORROW'?'・建議借車':'・建議還車') : '';
  const labelTxt = s.name + relayTag;
  const tw=pctx.measureText(labelTxt).width;
  pctx.fillStyle='rgba(18,21,26,.78)';pctx.fillRect(p.x-tw/2-5,pinY+r+7,tw+10,15);
  pctx.fillStyle=selected?'#e8e2d5':relayHere?'#d4bf6a':'#b7ad99';pctx.fillText(labelTxt,p.x,pinY+r+9);
}
function pubDrawUser(){
  const p=piso(USER_LOC.gx,USER_LOC.gy);const y=p.y+TILE.h/2;
  pctx.fillStyle='rgba(134,165,110,.25)';pctx.beginPath();pctx.arc(p.x,y-8,10+Math.sin(pulse)*3,0,Math.PI*2);pctx.fill();
  pctx.fillStyle='#86a56e';pctx.strokeStyle='#fff';pctx.lineWidth=2;
  pctx.beginPath();pctx.arc(p.x,y-8,6,0,Math.PI*2);pctx.fill();pctx.stroke();
  pctx.fillStyle='#e8e2d5';pctx.font='700 9px Oswald';pctx.textAlign='center';pctx.fillText('您的位置',p.x,y-26);
}
function pubDrawNav(){
  if(!STATE.pubNav)return;
  const a=piso(USER_LOC.gx,USER_LOC.gy), b=piso(STATE.pubNav.to.gx,STATE.pubNav.to.gy);
  const ax=a.x, ay=a.y+TILE.h/2-8, bx=b.x, by=b.y+TILE.h/2-26;
  const mx=(ax+bx)/2, my=Math.min(ay,by)-40;
  const t=Math.min(STATE.pubRouteAnim,1);
  pctx.strokeStyle='rgba(134,165,110,.95)';pctx.lineWidth=3;pctx.setLineDash([7,6]);pctx.lineDashOffset=-pulse*6;
  pctx.beginPath();pctx.moveTo(ax,ay);
  const steps=40;
  for(let i=1;i<=steps*t;i++){const u=i/steps;const x=(1-u)*(1-u)*ax+2*(1-u)*u*mx+u*u*bx;const y=(1-u)*(1-u)*ay+2*(1-u)*u*my+u*u*by;pctx.lineTo(x,y);}
  pctx.stroke();pctx.setLineDash([]);
}
function pubRenderMap(){
  if(PW===0){ pubResize(); if(PW===0) return; }
  pctx.clearRect(0,0,PW,PH);
  pubDrawGround();
  pubDrawBuildings();
  const sorted=[...DATA.stations].sort((a,b)=>(a.gx+a.gy)-(b.gx+b.gy));
  sorted.forEach(pubDrawMarker);
  pubDrawUser();
  pubDrawNav();
}
// public map click -> select station
pubCanvas.addEventListener('click',e=>{
  const r=pubCanvas.getBoundingClientRect();
  const mx=e.clientX-r.left,my=e.clientY-r.top;
  let hit=null,best=1e9;
  DATA.stations.forEach(s=>{const p=piso(s.gx,s.gy);const px=p.x,py=p.y+TILE.h/2-26;const d=Math.hypot(mx-px,my-py);if(d<20&&d<best){best=d;hit=s;}});
  if(hit) pubSelect(hit.id);
});

/* ---- view toggle ---- */
function toggleView(v){
  STATE.view=v;
  const pub = v==='public';
  document.body.classList.toggle('public-mode', pub);
  // sync both toggle widgets
  document.getElementById('tgl-ops').classList.toggle('active',!pub);
  document.getElementById('tgl-pub').classList.toggle('active',pub);
  document.getElementById('tgl-ops2').classList.toggle('active',!pub);
  document.getElementById('tgl-pub2').classList.toggle('active',pub);
  if(pub){
    // default the public selection to the ops-selected station for continuity
    if(!STATE.pubSelectedId) STATE.pubSelectedId=STATE.selectedId;
    const s=st(STATE.pubSelectedId);
    const inp=document.getElementById('pubSearch'); if(inp&&s)inp.value=s.name;
    pubResize(); pubRender();
  }
}

/* =====================================================================
   DEMO MODE  — scripted end-to-end story (no page refresh)
   ===================================================================== */
let demoRunning=false;
function runDemo(){
  if(demoRunning) return;
  demoRunning=true;
  const btn=document.getElementById('demoBtn');
  btn.classList.add('running'); btn.textContent='● DEMO RUNNING';
  const steps=[];
  const add=(delay,fn)=>steps.push({delay,fn});
  const T='0012';    // 三重捷運站 (cap 30) — demo target

  // [1] 站點目前正常，但趨勢正在惡化（仍有大量停車位 → 民眾行為有改善空間）
  add(0, ()=>{
    toggleView('operations');
    const s=st(T);
    s.avail=9; s.reportedAvail=9; s.suspectedFault=0; s.faultConfirmed=false; s.longestIdleMin=0;
    s.empty=21; s.status='normal'; s.issue='運作正常'; s.prio='LOW';
    s.delta30=-3; s.delta60=-6; s.imbalanceDuration=0;
    DATA.dispatches=DATA.dispatches.filter(d=>!d._staged);
    refreshAllAI(); STATE.calls=buildCalls();
    renderCalls(); renderDispatch(); updateTop(true);
    selectStation(T);
    toast('Step 1 · 三重捷運站 目前正常（9/30），但供給趨勢正在惡化');
  });
  // [2] 預測：30 分鐘後缺車風險（趨勢惡化，但仍有大量空位 → 民眾可協助）
  add(3000, ()=>{
    const s=st(T); s.delta30=-8; s.delta60=-13; s.empty=21;   // deteriorate further, docks available
    refreshStationAI(s); STATE.calls=buildCalls(); renderCalls(); selectStation(T);
    toast(`Step 2 · ${predictionService.label()} · 預測 30 分鐘後缺車風險 ${getStationRisk30(s)}%`);
  });
  // [3] Decision Engine 啟動
  add(2800, ()=>{ selectStation(T); toast('Step 3 · Decision Engine 啟動 · 判斷「該由誰處理」'); });
  // [4] 比較三種策略：立即派車 / 友愛接力 / 混合
  add(2800, ()=>{
    const c=interventionComparison(st(T));
    toast(`Step 4 · 比較（DEMO）· 友愛接力 改善~${c.relay.impact}% / 車隊 改善~${c.fleet.impact}% · Relay 快且成本低`);
  });
  // [5] AI 選擇 RELAY FIRST（站點仍有足夠空位，民眾還車可改善）
  add(2800, ()=>{
    const s=st(T);
    const iv=decideIntervention(s);
    // ensure a relay-first posture for the demo narrative
    if(iv.type==='FLEET'){ s.empty=Math.max(s.empty, Math.round(s.cap*0.6)); refreshStationAI(s); }
    startRelay();
    toast('Step 5 · AI 決策：RELAY FIRST · 先啟動友愛接力，鼓勵民眾還車');
  });
  // [6] Public View 出現友愛接力建議
  add(3000, ()=>{
    publishRelayToPublic();
    const rec=recommendNearbyStations(st(T),'bike')[0];
    if(rec) pubNavigate(rec.station.id);
    toast('Step 6 · Public View · 「建議還車到三重捷運站」+ 附近推薦導航');
  });
  // [7] 模擬一段時間後風險仍高 → Relay 改善不足
  add(4200, ()=>{
    toggleView('operations');
    const s=st(T);
    s.avail=Math.max(2, s.avail-4); s.reportedAvail=s.avail; s.empty=Math.min(s.cap, s.empty+4);
    s.delta30=-4; s.imbalanceDuration=18;
    refreshStationAI(s); STATE.calls=buildCalls(); renderCalls();
    selectStation(T);
    toast(`Step 7 · 友愛接力改善不足 · 目前 30min 風險仍 ${getStationRisk30(s)}%`);
  });
  // [8] 自動升級為 FLEET DISPATCH → 進入既有 dispatch flow
  add(2800, ()=>{
    selectStation(T);
    escalateToFleet();   // -> generateDispatch() (plan comparison + source optimization)
    toast('Step 8 · 升級為 FLEET DISPATCH · 產生調度方案（來源最佳化 + +5/+10/+15）');
  });
  // [9] AI 建議方案 + 調度前/後
  add(3000, ()=>{
    if(PLAN){
      const rec=PLAN.plans.find(p=>p.key===PLAN.recommendedKey);
      if(PLAN.selectedKey!==PLAN.recommendedKey){ PLAN.selectedKey=PLAN.recommendedKey; applyPlanToRoute(); renderRight(); }
      toast(`Step 9 · Decision Engine 建議 方案 ${rec.key} (+${rec.bikes}) · 調度前 ${rec.riskBefore}% → 後 30min ${rec.sim.targetRisk30}%`);
    }
  });
  // [10] Accept → 分階段派遣（DISPATCHING → IN TRANSIT → ARRIVED → RESOLVED）
  add(2800, ()=>{
    if(PLAN){ acceptDispatch(); toast('Step 10 · Accept · DISPATCHING → IN TRANSIT → ARRIVED → 風險重算'); }
  });
  // [11] 完成後回到站點看風險重算
  add(11000, ()=>{
    selectStation(T);
    toast(`Step 11 · 調度完成後重算 · 三重捷運站 目前 30min 風險 ${getStationRisk30(st(T))}%`);
  });
  // [12] 結束
  add(2600, ()=>{
    btn.classList.remove('running'); btn.textContent='▶ Demo Mode'; demoRunning=false;
    toast('Demo 完成 · Predict → Decide → Relay → Recalculate → Fleet Escalation');
  });

  // run the sequence
  let acc=0;
  steps.forEach(step=>{ acc+=step.delay; setTimeout(step.fn, acc); });
}

/* =====================================================================
   INIT
   ===================================================================== */
function init(){
  refreshAllAI();          // seed prediction + intervention on every station first
  resize();
  pubResize();
  renderCalls();
  renderDuty();
  renderDispatch();
  updateTop();
  selectStation('0012');   // open the top critical call
  STATE.pubSelectedId='0012';
  pubRender();
  tick(); setInterval(tick,1000);
  loop();

  // proactive anomaly notification on load (does not wait for operator click)
  setTimeout(()=>{
    const s=st('0012');
    if(s && (s.suspectedFault??0)>0 && !s.faultConfirmed){
      const rep=(s.reportedAvail ?? s.avail), eff=effectiveAvail(s);
      toast(`🚨 主動告警 · ${s.name} 發現 ${s.suspectedFault} 台疑似異常車輛 · 有效供給 ${rep} → ${eff}`);
    }
  }, 1500);

  // simulated live event: a warning escalates after a bit (marker pulse + counter)
  setTimeout(()=>{
    const s=st('0084'); if(s && s.status==='warning'){
      s.status='critical'; s.issue='無車可借'; s.avail=0; s.reportedAvail=0; s.suspectedFault=0; s.longestIdleMin=0; s.empty=s.cap; s.waitMin=24; s.prio='HIGH';
      STATE.calls=buildCalls();
      renderCalls(); updateTop(true);
      if(STATE.view==='public') pubRender();
      toast('新異常回報 · 蘆洲站 轉為 CRITICAL');
    }
  }, 9000);
}
window.addEventListener('resize',()=>{resize(); pubResize(); const s=st(STATE.selectedId); if(s&&STATE.detailMode==='detail')drawSpark(s); if(STATE.view==='public')pubRender();});
init();
</script>
