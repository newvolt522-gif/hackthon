// humanize internal status -> public-facing status
// returns {level:'green'|'yellow'|'red'|'park', chipTxt, chipIco, msg, alert}
function publicStatus(s){
  // 民眾端以「有效供給」作為可借車數；不暴露內部故障判斷。
  const bikes = effectiveAvail(s);
  const noBike = bikes===0;
  const noDock = s.empty===0;
  // 當帳面與有效供給有落差時，僅給一句柔性提醒（不提「故障 / 疑似異常」）
  const dataDiff = (s.suspectedFault ?? 0) > 0 && !noBike;
  const diffMsg = dataDiff ? '（即時車輛數量可能與實際可用狀況存在差異）' : '';
  if(noBike){
    return {level:'red', chipIco:'🔴', chipTxt:'暫無可借車輛', bikes,
      msg:'目前這個站點沒有可借的車輛，建議選擇下方附近其他站點。', alert:true};
  }
  if(noDock){
    return {level:'park', chipIco:'🅿', chipTxt:'目前無法還車', bikes,
      msg:'這個站點目前沒有可停放的車位，若您要還車，建議前往下方附近站點。', alert:true};
  }
  if(s.status==='warning' || bikes<=5 || dataDiff){
    return {level:'yellow', chipIco:'🟡', chipTxt:'車輛較少', bikes,
      msg:'目前可借車輛較少，可能很快借完，建議儘早前往或參考附近站點。'+diffMsg, alert:false};
  }
  return {level:'green', chipIco:'🟢', chipTxt:'可正常使用', bikes,
    msg:'目前可以正常借車與還車。', alert:false};
}

// distance (meters) from user location to a station, mock but consistent
function metersTo(gx,gy){
  const d=Math.hypot(gx-USER_LOC.gx, gy-USER_LOC.gy);
  return Math.round(d*180/10)*10;   // ~180m per grid unit, rounded to 10m
}
function walkMin(meters){ return Math.max(1, Math.round(meters/75)); } // ~75 m/min

// recommendation scoring: not distance-only.
// consider distance, available bikes, capacity headroom, and anomaly penalty.
function scoreStation(s, need /* 'bike' | 'dock' */){
  const meters=metersTo(s.gx,s.gy);
  const supply = need==='dock' ? s.empty : effectiveAvail(s);  // 可借以有效供給計算
  if(supply<=0) return null; // cannot serve the need
  const distScore   = 1 - Math.min(meters,1500)/1500;        // closer better (0..1)
  const supplyScore = Math.min(supply,20)/20;                 // more supply better
  const capScore    = Math.min(s.cap,40)/40;                  // bigger station = more reliable
  const anomalyPen  = (s.status==='critical'||s.status==='warning') ? 0.75 : 1;
  // AI-aware: prefer stations where the user's action ALSO helps rebalancing (relay-recommended),
  // and prefer stations predicted to still be usable in 30 min (avoid ones about to run out).
  const iv = s.intervention || decideIntervention(s);
  const helpfulRelay = (need==='dock' && (iv.direction==='RETURN'||iv.direction==='BOTH'))
                    || (need==='bike' && (iv.direction==='BORROW'||iv.direction==='BOTH'));
  const relayBoost = (helpfulRelay && (iv.type==='RELAY'||iv.type==='HYBRID')) ? 0.12 : 0;
  const pred = getPrediction(s);
  const futureOK = need==='dock' ? pred.predictedEmptyDockRatio30 : pred.predictedAvailableRatio30; // 0..1
  const predScore = Math.min(1, futureOK*1.4);               // reward staying usable in 30 min
  const score = (distScore*0.34 + supplyScore*0.34 + capScore*0.14 + predScore*0.18) * anomalyPen + relayBoost;
  return { station:s, meters, min:walkMin(meters), supply, score, relayRecommended:relayBoost>0 };
}

// find nearby alternatives that can serve the need (bike to borrow / dock to return)
function recommendNearbyStations(target, need){
  return DATA.stations
    .filter(s=>s.id!==target.id)
    .map(s=>scoreStation(s,need))
    .filter(Boolean)
    .sort((a,b)=>b.score-a.score)
    .slice(0,4);
}

// does this station qualify for community relay hint?
// hint shown for stations that are low on bikes but still have dock space (return demand helps rebalance)
function relayEligible(s){
  const eff=effectiveAvail(s);
  return (s.status==='warning' || (eff<=5 && eff>0)) && s.empty>=3;
}

