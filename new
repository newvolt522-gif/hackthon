// 缺車風險：以有效供給評估（非帳面 avail），並將疑似異常視為額外壓力
function demandRisk(s){
  const eff=effectiveAvail(s);
  const hasAnom=(s.suspectedFault ?? 0)>0;
  if(s.empty===0) return {level:'low', label:'—（滿位）'};
  // 有疑似異常車時，有效供給的可靠度下降，風險門檻上調
  if(eff<=2 || (hasAnom && eff<=6)) return {level:'high', label:'HIGH · 預估 30 分鐘內可能缺車'};
  if(eff<=6) return {level:'med',  label:'MEDIUM · 供給偏緊'};
  return {level:'low', label:'LOW · 供給充足'};
}

function drawSpark(s){
  const cv=document.getElementById('sparkCv'); if(!cv)return;
  const r=cv.parentElement.getBoundingClientRect();
  cv.width=r.width*DPR;cv.height=r.height*DPR;cv.style.width=r.width+'px';cv.style.height=r.height+'px';
  const c=cv.getContext('2d');c.setTransform(DPR,0,0,DPR,0,0);
  const w=r.width,h=r.height;
  // synth trend ending at current avail
  const n=24;const pts=[];let v=s.cap*0.5;
  for(let i=0;i<n;i++){ v+= (rnd(i+s.gx, s.gy)-0.5)*s.cap*0.28; v=Math.max(0,Math.min(s.cap,v)); pts.push(v); }
  const eff=effectiveAvail(s);
  pts[n-1]=eff; pts[n-2]=(pts[n-2]+eff)/2;
  const col=statusColor(s.status);
  // baseline
  c.strokeStyle='rgba(183,173,153,.12)';c.beginPath();c.moveTo(0,h-12);c.lineTo(w,h-12);c.stroke();
  // area + line
  c.beginPath();
  pts.forEach((p,i)=>{const x=6+i*(w-12)/(n-1);const y=h-8-(p/s.cap)*(h-18);i?c.lineTo(x,y):c.moveTo(x,y);});
  c.strokeStyle=col;c.lineWidth=1.8;c.stroke();
  // fill
  c.lineTo(w-6,h-8);c.lineTo(6,h-8);c.closePath();
  c.fillStyle=col+'22';c.fill();
  // end dot
  const lx=6+(n-1)*(w-12)/(n-1), ly=h-8-(eff/s.cap)*(h-18);
  c.fillStyle=col;c.beginPath();c.arc(lx,ly,3,0,Math.PI*2);c.fill();
}

