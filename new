function generateDispatch(){
  const target=st(STATE.selectedId); if(!target)return;
  // 1) source optimization — rank by post-dispatch source risk (not distance-only)
  const candidates=getSourceCandidates(target, 10);
  const source=(candidates[0] && candidates[0].station) || bestSource(target);
  if(!source){ toast('附近無可用來源站'); return; }

  // 2) build three plans +5 / +10 / +15 (bounded by source dispatchable / safeReserve)
  const maxDisp=dispatchable(source);
  const plans=[5,10,15].map(bikes=>{
    const benefit=calculateDispatchBenefit(target, source, bikes);
    return {
      key:bikes===5?'A':bikes===10?'B':'C',
      bikes, ...benefit
    };
  });

  // 3) pick recommended = highest benefit score among feasible plans
  const feasible=plans.filter(p=>p.feasible);
  const recommended=(feasible.length?feasible:plans).slice().sort((a,b)=>b.score-a.score)[0];

  PLAN={ target, source, candidates, plans, recommendedKey:recommended.key, selectedKey:recommended.key, maxDisp };
  applyPlanToRoute();
  STATE.detailMode='reco';
  renderRight();
}

// sync ROUTE + map readout to the currently selected plan
